{
  "serie": "ilha-perdida",
  "parte": 1,
  "titulo": "As pegadas",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "leo",
      "off": true,
      "tom": "misterioso",
      "texto": "Eu achei que era o único nessa ilha."
    },
    {
      "id": "f2",
      "quem": "leo",
      "off": true,
      "tom": "triste",
      "texto": "Três dias sem comida, sem sinal... e sem ninguém pra me salvar."
    },
    {
      "id": "f3",
      "quem": "leo",
      "off": true,
      "tom": "misterioso",
      "texto": "Até que, na beira do mar, eu vi uma coisa."
    },
    {
      "id": "f4",
      "quem": "leo",
      "off": true,
      "tom": "tenso",
      "texto": "Pegadas.",
      "pausa_depois": 0.5
    },
    {
      "id": "f5",
      "quem": "leo",
      "off": true,
      "tom": "tenso",
      "texto": "Enormes. De três dedos."
    },
    {
      "id": "f6",
      "quem": "leo",
      "tom": "sussurro",
      "texto": "Isso não é pé de gente..."
    },
    {
      "id": "f7",
      "quem": "leo",
      "off": true,
      "texto": "E elas saíam do mar... direto pra floresta."
    },
    {
      "id": "f8",
      "quem": "leo",
      "off": true,
      "texto": "Qualquer pessoa normal teria fugido."
    },
    {
      "id": "f9",
      "quem": "leo",
      "tom": "nervoso",
      "texto": "Tá bom... só uma olhadinha.",
      "pausa_depois": 0.35
    },
    {
      "id": "f10",
      "quem": "leo",
      "off": true,
      "tom": "tenso",
      "texto": "Lá dentro tava tudo quieto. Quieto DEMAIS."
    },
    {
      "id": "f11",
      "quem": "leo",
      "off": true,
      "tom": "tenso",
      "texto": "Nem os pássaros cantavam."
    },
    {
      "id": "f12",
      "quem": "leo",
      "off": true,
      "texto": "E aí eu achei uma fogueira."
    },
    {
      "id": "f13",
      "quem": "leo",
      "off": true,
      "tom": "sussurro",
      "texto": "Ainda quente.",
      "pausa_depois": 0.4
    },
    {
      "id": "f14",
      "quem": "leo",
      "off": true,
      "tom": "medo",
      "texto": "Ou seja... eu NÃO tava sozinho."
    },
    {
      "id": "f15",
      "quem": "leo",
      "tom": "sussurro",
      "texto": "Oi...? Tem alguém aí?"
    },
    {
      "id": "s1",
      "silencio": 0.8
    },
    {
      "id": "f16",
      "quem": "bia",
      "off": true,
      "tom": "sussurro",
      "velocidade": 0.9,
      "texto": "Não se mexe.",
      "pausa_depois": 0.45
    },
    {
      "id": "f17",
      "quem": "leo",
      "off": true,
      "tom": "medo",
      "texto": "A voz veio de trás de mim."
    },
    {
      "id": "f18",
      "quem": "leo",
      "off": true,
      "tom": "medo",
      "texto": "Mas o que me deixou gelado... foi o que tava na minha FRENTE."
    },
