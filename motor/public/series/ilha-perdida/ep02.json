    {"id": "f9", "quem": "bia", "tom": "serio", "texto": "Eu chamo de Gigante. Ele só sai quando escurece."},
    {"id": "f10", "quem": "leo", "tom": "sussurro", "texto": "Você mora aqui?"},
    {"id": "f11", "quem": "bia", "tom": "triste", "texto": "Faz um ano. Os outros do meu barco... não tiveram tanta sorte.", "pausa_depois": 0.4},
    {"id": "f12", "quem": "leo", "off": true, "texto": "Foi aí que ela acendeu a lanterna... e eu vi as paredes."},
    {"id": "f13", "quem": "leo", "off": true, "texto": "Tinha risco pra todo lado. Ela contava os dias."},
    {"id": "f14", "quem": "leo", "texto": "Tem algum jeito de sair dessa ilha?"},
    {"id": "f15", "quem": "bia", "tom": "determinado", "texto": "Tem. Mas pra isso a gente precisa entrar na caverna dele.", "pausa_depois": 0.4},
    {"id": "f16", "quem": "leo", "off": true, "tom": "tenso", "texto": "E ela não tava brincando."},
