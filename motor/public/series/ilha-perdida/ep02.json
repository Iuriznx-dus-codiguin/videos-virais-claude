    {"id": "f3", "quem": "leo", "off": true, "tom": "medo", "texto": "Eu não corri. Eu nem respirei."},
    {"id": "f4", "quem": "leo", "off": true, "tom": "tenso", "texto": "Aí o chão começou a tremer.", "pausa_depois": 0.9},
