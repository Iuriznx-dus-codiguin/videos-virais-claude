    "@remotion/media": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/three": "4.0.538",
    "@vercel/blob": "2.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
