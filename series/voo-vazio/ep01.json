{
  "serie": "voo-vazio",
  "parte": 1,
  "titulo": "Assento 31C",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "narradora",
      "off": true,
      "texto": "Se você acordar num avião em pleno voo e todo mundo tiver sumido, não chame ninguém.",
      "tom": "tenso"
    },
    {
      "id": "f2",
      "quem": "narradora",
      "off": true,
      "texto": "Voo 2207, de Manaus para São Paulo. Você tem dezesseis anos e viaja sozinha pela primeira vez."
    },
    {
      "id": "f3",
      "quem": "narradora",
      "off": true,
      "texto": "Meia-noite e doze, você acorda no assento trinta e um C.",
      "tom": "serio"
    },
    {
      "id": "f4",
      "quem": "narradora",
      "off": true,
      "texto": "Cento e quarenta e cinco bancos. E todos VAZIOS.",
      "tom": "tenso"
    },
    {
      "id": "f5",
      "quem": "narradora",
      "off": true,
      "texto": "Em cada banco, um celular aceso. Bolsas abertas. Cintos soltos."
    },
    {
      "id": "f6",
      "quem": "sofia",
      "texto": "Oi? Tem alguém aí?",
      "tom": "nervoso"
    },
    {
      "id": "f7",
      "quem": "narradora",
      "off": true,
      "texto": "Seu primeiro instinto é correr até a frente e chamar a comissária."
    },
    {
      "id": "f8",
      "quem": "narradora",
      "off": true,
      "texto": "Não. Na sua bandeja tem um bilhete. Letra de mulher.",
      "tom": "serio"
    },
    {
      "id": "f9",
      "quem": "narradora",
      "off": true,
      "texto": "Regra um: não vá até a frente.",
      "tom": "serio"
    },
    {
      "id": "f10",
      "quem": "narradora",
      "off": true,
      "texto": "Regra dois: não atenda nenhum celular.",
      "tom": "serio"
    },
    {
      "id": "f11",
      "quem": "narradora",
      "off": true,
      "texto": "Regra três: se chamarem o seu nome, não RESPONDA.",
      "tom": "tenso"
    },
    {
      "id": "f12",
      "quem": "narradora",
      "off": true,
      "texto": "Embaixo, só uma letra: V."
    },
    {
      "id": "f13",
      "quem": "narradora",
      "off": true,
      "texto": "A boa notícia é que alguém está pilotando."
    },
    {
      "id": "f14",
      "quem": "narradora",
      "off": true,
      "texto": "A má notícia é o que ele fala no alto-falante.",
      "tom": "tenso"
    },
    {
      "id": "f15",
      "quem": "breno",
      "off": true,
      "texto": "Senhores passageiros, permaneçam sentados.",
      "tom": "interfone"
    },
    {
      "id": "f16",
      "quem": "narradora",
      "off": true,
      "texto": "Ele está falando com cento e quarenta e cinco bancos vazios.",
      "tom": "tenso"
    },
    {
      "id": "f17",
      "quem": "narradora",
      "off": true,
      "texto": "Lá na frente, atrás da cortina, uma lanterna acende. E apaga."
    },
    {
      "id": "f18",
      "quem": "narradora",
      "off": true,
      "texto": "Você se encolhe no banco, apaga a luzinha e prende a respiração."
    },
    {
      "id": "f19",
      "quem": "narradora",
      "off": true,
      "texto": "Pelo menos ninguém sabe que você está aqui.",
      "tom": "aliviado"
    },
    {
      "id": "f20",
      "quem": "breno",
      "off": true,
      "texto": "Passageira do trinta e um C. Aperte o botão de chamada.",
      "tom": "interfone"
    },
    {
      "id": "f21",
      "quem": "narradora",
      "off": true,
      "texto": "Ele sabe exatamente onde você ESTÁ.",
      "tom": "tenso"
    }
  ],
