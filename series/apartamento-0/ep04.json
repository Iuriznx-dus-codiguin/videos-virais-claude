{
 "serie": "apartamento-0",
 "parte": 4,
 "titulo": "A zeladoria",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Se o interfone tocar de um apartamento que pegou fogo, não desligue."
  },
  {
   "id": "f2",
   "quem": "narrador",
   "off": true,
   "texto": "Três da manhã. O carro do Seu Jorge continua na vaga quarenta e nove."
  },
  {
   "id": "f3",
   "quem": "rafa",
   "tom": "nervoso",
   "texto": "Ninguém some e deixa a chave no carro."
  },
  {
   "id": "f4",
   "quem": "narrador",
   "off": true,
   "texto": "O Rafa mora aqui desde criança. E sabe uma coisa que você não sabe."
  },
  {
   "id": "f5",
   "quem": "rafa",
   "tom": "serio",
   "texto": "O apartamento zero existia. Era a zeladoria."
  },
  {
   "id": "f6",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "No subsolo, do lado da garagem. Pegou fogo em dois mil e nove."
  },
  {
   "id": "f6b",
   "quem": "rafa",
   "off": true,
   "tom": "serio",
   "texto": "Quem apagou o fogo foi o Seu Jorge. Sozinho."
  },
  {
   "id": "f7",
   "quem": "narrador",
   "off": true,
   "texto": "Depois do incêndio, a síndica mandou fechar a porta com tijolo."
  },
  {
   "id": "f8",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Ninguém entra lá faz dezessete anos."
  },
  {
   "id": "f9",
   "quem": "narrador",
   "off": true,
   "texto": "Seu primeiro instinto é achar que é trote. Criança brincando no interfone."
  },
  {
   "id": "f10",
   "quem": "narrador",
   "off": true,
   "tom": "serio",
   "texto": "Não. Trote não tem linha própria na central do interfone."
  },
  {
   "id": "f11",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Você abre a central. Linha zero: LIGADA."
  },
  {
   "id": "f12",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "E o fio dela não desce pro subsolo. Sobe pro apartamento da síndica."
  },
  {
   "id": "f13",
   "quem": "rafa",
   "tom": "nervoso",
   "texto": "Por que o zero passa pela casa dela?"
  },
  {
   "id": "f13b",
   "quem": "narrador",
   "off": true,
   "texto": "Então vocês combinam: se o zero tocar hoje, ninguém desliga.",
   "pausa_depois": 0.3
  },
  {
   "id": "f14",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Três e onze. As luzes apagam. E o interfone toca."
  },
  {
   "id": "f15",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Você atende. Mas a voz agora é outra. Cansada.",
   "pausa_depois": 0.4
  },
  {
   "id": "f16",
   "quem": "jorge",
   "off": true,
   "tom": "interfone",
   "texto": "Não abre a garagem. Sou eu, o Jorge.",
   "pausa_depois": 0.3
  },
  {
   "id": "f17",
   "quem": "porteiro",
   "tom": "nervoso",
   "texto": "Seu Jorge? Onde o senhor tá?"
  },
  {
   "id": "f18",
   "quem": "narrador",
   "off": true,
   "texto": "Ele está vivo. Pela primeira vez na noite, você respira."
  },
  {
   "id": "f18b",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Só que a voz dele não vem de nenhum andar.",
   "pausa_depois": 0.5
  },
  {
   "id": "f19",
   "quem": "jorge",
   "off": true,
   "tom": "interfone",
   "texto": "Eu tô embaixo de vocês.",
   "pausa_depois": 0.5
  }
 ],
