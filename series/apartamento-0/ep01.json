{
 "serie": "apartamento-0",
 "parte": 1,
 "titulo": "Apartamento 0",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Se o interfone tocar de um apartamento que NÃO existe, nunca diga o seu nome."
  },
  {
   "id": "f2",
   "quem": "narrador",
   "off": true,
   "texto": "Hoje é a sua primeira noite como porteiro do Edifício Aurora."
  },
  {
   "id": "f3",
   "quem": "narrador",
   "off": true,
   "texto": "Doze andares, quarenta e oito apartamentos. E só você acordado."
  },
  {
   "id": "f3b",
   "quem": "narrador",
   "off": true,
   "tom": "serio",
   "texto": "O salário é o dobro. Mesmo assim, ninguém quis a vaga."
  },
  {
   "id": "f4",
   "quem": "narrador",
   "off": true,
   "tom": "serio",
   "texto": "O porteiro antigo, o Seu Jorge, sumiu faz sete dias. Sem avisar ninguém."
  },
  {
   "id": "f5",
   "quem": "narrador",
   "off": true,
   "texto": "Às dez da noite, a síndica manda as regras no grupo do prédio."
  },
  {
   "id": "f6",
   "quem": "narrador",
   "off": true,
   "tom": "serio",
   "texto": "Regra um: depois da meia-noite, o portão não abre pra ninguém."
  },
  {
   "id": "f7",
   "quem": "narrador",
   "off": true,
   "tom": "serio",
   "texto": "Regra dois: você NUNCA sai da guarita."
  },
  {
   "id": "f8",
   "quem": "narrador",
   "off": true,
   "tom": "animado",
   "texto": "A boa notícia é que tem câmera em tudo."
  },
  {
   "id": "f9",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "A má notícia é que o interfone tem um botão a mais. O zero."
  },
  {
   "id": "f9b",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Quarenta e oito apartamentos. E quarenta e nove botões."
  },
  {
   "id": "f10",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Às três da manhã, as luzes do prédio começam a apagar. Andar por andar."
  },
  {
   "id": "f11",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "De cima pra baixo, até chegar no térreo."
  },
  {
   "id": "f12",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Então, o interfone toca. No visor: apartamento ZERO.",
   "pausa_depois": 0.4
  },
  {
   "id": "f13",
   "quem": "porteiro",
   "tom": "nervoso",
   "texto": "Portaria, boa noite?",
   "pausa_depois": 0.7
  },
  {
   "id": "f14",
   "quem": "vulto",
   "off": true,
   "tom": "interfone",
   "texto": "Abre a garagem. Rápido, por favor."
  },
  {
   "id": "f15",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Na câmera quatro, tem alguém parado na garagem. Olhando pra você."
  },
  {
   "id": "f15b",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Só que a garagem está trancada desde a meia-noite."
  },
  {
   "id": "f16",
   "quem": "narrador",
   "off": true,
   "texto": "Você abre o livro da portaria. Última página, letra do Seu Jorge:"
  },
  {
   "id": "f17",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Se o zero ligar, não diga seu nome. ELA está ouvindo.",
   "pausa_depois": 0.4
  },
  {
   "id": "f18",
   "quem": "vulto",
   "off": true,
   "tom": "interfone",
   "pausa_depois": 0.5,
   "texto": "Você não é o Jorge. Qual é o seu nome?"
  }
