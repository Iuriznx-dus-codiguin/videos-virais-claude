{
 "serie": "apartamento-0",
 "parte": 3,
 "titulo": "O livro",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Se a síndica pedir o livro da portaria sorrindo, nunca entregue ele inteiro."
  },
  {
   "id": "f2",
   "quem": "narrador",
   "off": true,
   "texto": "Seis da tarde. A Dona Marta bate no vidro da guarita."
  },
  {
   "id": "f3",
   "quem": "marta",
   "texto": "Boa tarde, querido. Me empresta o livro? Só pra conferir."
  },
  {
   "id": "f4",
   "quem": "narrador",
   "off": true,
   "texto": "Seu primeiro instinto é entregar. Ela manda no prédio."
  },
  {
   "id": "f5",
   "quem": "narrador",
   "off": true,
   "tom": "serio",
   "texto": "Não. Ontem às três e vinte, ela olhou direto pra guarita."
  },
  {
   "id": "f6",
   "quem": "narrador",
   "off": true,
   "texto": "No livro está o recado do Seu Jorge, o porteiro que sumiu."
  },
  {
   "id": "f7",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Escrito com a letra dele: ELA está ouvindo."
  },
  {
   "id": "f8",
   "quem": "narrador",
   "off": true,
   "texto": "Então você arranca a página e esconde. Rápido."
  },
  {
   "id": "f9",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Ela folheia. E para bem onde falta a folha.",
   "pausa_depois": 0.4
  },
  {
   "id": "f10",
   "quem": "marta",
   "texto": "Engraçado. O Jorge também arrancava páginas.",
   "pausa_depois": 0.5
  },
  {
   "id": "f11",
   "quem": "narrador",
   "off": true,
   "texto": "Três e dois da manhã. Uma moto buzina no portão."
  },
  {
   "id": "f12",
   "quem": "rafa",
   "texto": "Abre aí! Eu moro no trezentos e três!"
  },
  {
   "id": "f13",
   "quem": "narrador",
   "off": true,
   "texto": "É o Rafa, motoboy do terceiro. Mas depois da meia-noite, o portão não abre."
  },
  {
   "id": "f14",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Você abre mesmo assim. Primeira regra quebrada."
  },
  {
   "id": "f15",
   "quem": "rafa",
   "texto": "Valeu! O Seu Jorge sempre me abria."
  },
  {
   "id": "f16",
   "quem": "narrador",
   "off": true,
   "texto": "Ele guarda a moto e manda mensagem lá da garagem."
  },
  {
   "id": "f17",
   "quem": "narrador",
   "off": true,
   "texto": "Quarenta e oito vagas. Conta os carros na câmera."
  },
  {
   "id": "f18",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Você conta. Uma vez. Duas. Quarenta e NOVE."
  },
  {
   "id": "f19",
   "quem": "porteiro",
   "tom": "aliviado",
   "texto": "Deve ser carro de alguma visita."
  },
  {
   "id": "f20",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Visita? Com o portão trancado desde a meia-noite?"
  },
  {
   "id": "f21",
   "quem": "narrador",
   "off": true,
   "texto": "Aí chega outra mensagem.",
   "pausa_depois": 0.3
  },
  {
   "id": "f22",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "O carro a mais é do Seu Jorge. Com a chave ainda no contato.",
   "pausa_depois": 0.5
  },
  {
   "id": "f23",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Ele nunca foi embora.",
   "pausa_depois": 0.5
  }
 ],
