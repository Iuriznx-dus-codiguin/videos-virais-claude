{
 "serie": "apartamento-0",
 "parte": 7,
 "titulo": "A última regra",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Se a síndica te trancar no subsolo, não grite por socorro. ELA tá ouvindo."
  },
  {
   "id": "f2",
   "quem": "narrador",
   "off": true,
   "texto": "Mas você tem a única prova contra ela: o vídeo da câmera quatro."
  },
  {
   "id": "f3",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Só que travou em noventa e nove por cento. Aqui embaixo, sem sinal.",
   "pausa_depois": 0.4
  },
  {
   "id": "f4",
   "quem": "marta",
   "off": true,
   "tom": "interfone",
   "texto": "Quando o caminhão sair, o Caio desce pra conversar."
  },
  {
   "id": "f5",
   "quem": "narrador",
   "off": true,
   "texto": "O primeiro instinto do Rafa é esmurrar a porta."
  },
  {
   "id": "f6",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Não. Quarenta e oito apartamentos dormindo. Só ELA ouve."
  },
  {
   "id": "f7",
   "quem": "jorge",
   "tom": "cansado",
   "texto": "Lá em cima tem uma grade pra rua. Ali pega sinal."
  },
  {
   "id": "f8",
   "quem": "narrador",
   "off": true,
   "texto": "A grade fica no alto. A escada? As caixas que ela roubou."
  },
  {
   "id": "f9",
   "quem": "narrador",
   "off": true,
   "tom": "animado",
   "texto": "Uma barrinha de sinal. Enviado."
  },
  {
   "id": "f10",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Só que quem manda no grupo é ela. Dez segundos, e o vídeo some."
  },
  {
   "id": "f11",
   "quem": "narrador",
   "off": true,
   "texto": "Mas a Dona Cleide, do sétimo, já tinha baixado.",
   "pausa_depois": 0.4
  },
  {
   "id": "f12",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Três e quarenta e sete, o caminhão sai. E a porta abre."
  },
  {
   "id": "f13",
   "quem": "caio",
   "tom": "calmo",
   "texto": "Boa noite. Desculpa a demora."
  },
  {
   "id": "f14",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Atrás dele, a garagem que ela deixava no escuro tá vermelha e azul."
  },
  {
   "id": "f15",
   "quem": "narrador",
   "off": true,
   "texto": "É a polícia. O Caio sai algemado."
  },
  {
   "id": "f16",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "A síndica corre pro portão da frente."
  },
  {
   "id": "f17",
   "quem": "marta",
   "tom": "bravo",
   "texto": "Porteiro, abre esse portão. AGORA!"
  },
  {
   "id": "f18",
   "quem": "porteiro",
   "tom": "determinado",
   "texto": "Regra um, Dona Marta. Depois da meia-noite, o portão não abre."
  },
  {
   "id": "f19",
   "quem": "narrador",
   "off": true,
   "texto": "A regra que ela mesma escreveu.",
   "pausa_depois": 0.5
  },
  {
   "id": "f20",
   "quem": "narrador",
   "off": true,
   "tom": "aliviado",
   "texto": "De manhã, a Marta não é mais síndica. E o Seu Jorge volta pra guarita."
  },
  {
   "id": "f21",
   "quem": "jorge",
   "tom": "calmo",
   "texto": "A vaga da noite é sua, filho."
  },
  {
   "id": "f22",
   "quem": "narrador",
   "off": true,
   "texto": "No livro, com a letra dele, uma regra nova.",
   "pausa_depois": 0.4
  },
  {
   "id": "f23",
   "quem": "narrador",
   "off": true,
   "tom": "calmo",
   "texto": "Regra três: confie no porteiro da noite."
  }
 ],
