 "falas": [
  {
   "id": "f1",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Se alguém pedir socorro no prédio e a síndica mandar você ficar parado, desconfie dela."
  },
  {
   "id": "f2",
   "quem": "narrador",
   "off": true,
   "texto": "Três e doze da manhã. Você desliga o interfone sem dizer o seu nome."
  },
  {
   "id": "f3",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Silêncio. Na câmera quatro, a garagem agora está vazia."
  },
  {
   "id": "f4",
   "quem": "narrador",
   "off": true,
   "texto": "Aí o celular vibra. É a Dona Cleide, do sétimo andar."
  },
  {
   "id": "f5",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Tem alguém andando no corredor dela. Batendo de porta em porta."
  },
  {
   "id": "f6",
   "quem": "narrador",
   "off": true,
   "texto": "Em menos de dez segundos, a síndica responde."
  },
  {
   "id": "f7",
   "quem": "narrador",
   "off": true,
   "tom": "serio",
   "texto": "Porteiro, NÃO saia da guarita. E Cleide, volta a dormir."
  },
  {
   "id": "f8",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "A síndica estava acordada às três da manhã. Esperando o quê?"
  },
  {
   "id": "f9",
   "quem": "narrador",
   "off": true,
   "tom": "animado",
   "texto": "A boa notícia é que o prédio tem câmera em todos os andares."
  },
  {
   "id": "f10",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "A má notícia é que a do sétimo está desligada desde ontem."
  },
  {
   "id": "f11",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Então o interfone toca de novo. Apartamento ZERO."
  },
  {
   "id": "f12",
   "quem": "vulto",
   "off": true,
   "tom": "interfone",
   "texto": "Não sobe. Olha a câmera dois."
  },
  {
   "id": "f13",
   "quem": "narrador",
   "off": true,
   "texto": "Câmera dois, o hall. A porta do elevador abre."
  },
  {
   "id": "f14",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Uma mulher de roupão atravessa o hall e vai pra garagem."
  },
  {
   "id": "f15",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Três e vinte da manhã. É a Dona Marta. A síndica."
  },
  {
   "id": "f16",
   "quem": "porteiro",
   "tom": "nervoso",
   "texto": "O que ela tá fazendo lá embaixo?"
  },
  {
   "id": "f17",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Na frente da garagem, ela para. E olha direto pra câmera."
  },
  {
   "id": "f18",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Depois vira o rosto, bem devagar. Pra guarita."
