{
 "serie": "apartamento-0",
 "parte": 5,
 "titulo": "Câmera quatro",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Se a luz do prédio apaga toda noite na mesma hora, alguém não quer ser filmado."
  },
  {
   "id": "f2",
   "quem": "narrador",
   "off": true,
   "texto": "Ontem, a voz do Seu Jorge veio lá de baixo. Do apartamento zero."
  },
  {
   "id": "f3",
   "quem": "porteiro",
   "tom": "nervoso",
   "texto": "Eu vou chamar a polícia agora."
  },
  {
   "id": "f4",
   "quem": "narrador",
   "off": true,
   "tom": "serio",
   "texto": "Não. Sem prova, a síndica diz que foi trote. E o Jorge some de vez."
  },
  {
   "id": "f5",
   "quem": "rafa",
   "tom": "determinado",
   "texto": "Então a gente filma. Câmera quatro."
  },
  {
   "id": "f6",
   "quem": "narrador",
   "off": true,
   "tom": "animado",
   "texto": "A boa notícia: o Rafa ligou a câmera numa bateria escondida."
  },
  {
   "id": "f7",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "A má notícia: a bateria só aguenta QUATRO minutos."
  },
  {
   "id": "f7b",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Se a luz apagar às três e onze, vocês têm até três e quinze."
  },
  {
   "id": "f8",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Três e onze. As luzes apagam, andar por andar."
  },
  {
   "id": "f9",
   "quem": "narrador",
   "off": true,
   "texto": "O prédio inteiro fica no escuro. Menos a câmera quatro."
  },
  {
   "id": "f9b",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Aí chega mensagem da síndica: Porteiro, tudo certo aí?"
  },
  {
   "id": "f9c",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Vocês não respondem."
  },
  {
   "id": "f10",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Na garagem, o vulto de capuz carrega caixas. Uma, duas, dez."
  },
  {
   "id": "f11",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Todas pra mesma porta. A do apartamento zero."
  },
  {
   "id": "f12",
   "quem": "rafa",
   "tom": "nervoso",
   "texto": "Ninguém guarda caixa num lugar queimado."
  },
  {
   "id": "f13",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Aí o vulto para embaixo da câmera. E tira o capuz.",
   "pausa_depois": 0.4
  },
  {
   "id": "f14",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "É o Caio. O sobrinho da síndica."
  },
  {
   "id": "f14b",
   "quem": "narrador",
   "off": true,
   "texto": "O moço educado que carrega as compras da tia todo domingo."
  },
  {
   "id": "f15",
   "quem": "narrador",
   "off": true,
   "texto": "Três minutos e meio gravados. Tudo no celular do Rafa."
  },
  {
   "id": "f16",
   "quem": "narrador",
   "off": true,
   "tom": "aliviado",
   "texto": "Pela primeira vez, vocês têm como provar tudo."
  },
  {
   "id": "f16b",
   "quem": "rafa",
   "tom": "animado",
   "texto": "Amanhã cedo, isso vai pra polícia."
  },
  {
   "id": "f17",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Só que o Caio olha pra câmera. E sorri.",
   "pausa_depois": 0.4
  },
  {
   "id": "f18",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "E vem andando pra guarita.",
   "pausa_depois": 0.5
  }
