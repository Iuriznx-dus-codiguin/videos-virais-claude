{
 "serie": "apartamento-0",
 "parte": 6,
 "titulo": "O subsolo",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Se a única regra que te protege é ficar na guarita, hoje você vai quebrar ela."
  },
  {
   "id": "f2",
   "quem": "narrador",
   "off": true,
   "texto": "Ontem, o Caio veio até a guarita. Bateu duas vezes no vidro."
  },
  {
   "id": "f3",
   "quem": "caio",
   "tom": "serio",
   "texto": "Bateria boa essa da câmera quatro.",
   "pausa_depois": 0.3
  },
  {
   "id": "f4",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Ele sabe da gravação."
  },
  {
   "id": "f5",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Três e vinte, o caminhão entra de ré. O Caio desce pra descarregar."
  },
  {
   "id": "f6",
   "quem": "narrador",
   "off": true,
   "tom": "animado",
   "texto": "A boa notícia: com o Caio no caminhão, a porta do zero fica sozinha."
  },
  {
   "id": "f7",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "A má notícia: pra chegar lá, você tem que sair da guarita."
  },
  {
   "id": "f8",
   "quem": "porteiro",
   "tom": "nervoso",
   "texto": "E se a síndica vê a gente na câmera?"
  },
  {
   "id": "f9",
   "quem": "rafa",
   "tom": "determinado",
   "texto": "Se a gente esperar, amanhã o Jorge nem tá mais lá."
  },
  {
   "id": "f10",
   "quem": "narrador",
   "off": true,
   "texto": "O Rafa manda o vídeo pro grupo do prédio. E vocês descem."
  },
  {
   "id": "f11",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "A rampa tá no escuro. O motor do caminhão cobre os passos."
  },
  {
   "id": "f12",
   "quem": "narrador",
   "off": true,
   "texto": "No fim do corredor queimado, a porta que devia ter tijolo."
  },
  {
   "id": "f13",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "A chave tá do lado de fora."
  },
  {
   "id": "f14",
   "quem": "narrador",
   "off": true,
   "texto": "Lá dentro, caixas até o teto. Tudo roubado."
  },
  {
   "id": "f15",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "E no canto, magro e de barba, o Seu Jorge. VIVO.",
   "pausa_depois": 0.3
  },
  {
   "id": "f16",
   "quem": "jorge",
   "tom": "cansado",
   "texto": "Vocês vieram... Rápido, antes que ele volte."
  },
  {
   "id": "f17",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "No celular do Rafa, o vídeo travou em noventa e nove por cento. Sem sinal."
  },
  {
   "id": "f18",
   "quem": "jorge",
   "tom": "cansado",
   "texto": "Qual é o seu nome, filho?"
  },
  {
   "id": "f19",
   "quem": "narrador",
   "off": true,
   "tom": "aliviado",
   "texto": "Você fala. Aqui, ninguém tá ouvindo.",
   "pausa_depois": 0.4
  },
  {
   "id": "f20",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "Aí a porta bate atrás de vocês. E tranca por fora."
  },
  {
   "id": "f21",
   "quem": "narrador",
   "off": true,
   "tom": "tenso",
   "texto": "E o interfone da parede toca. O do apartamento zero.",
   "pausa_depois": 0.5
  },
  {
   "id": "f22",
   "quem": "marta",
   "off": true,
   "tom": "interfone",
   "texto": "Boa noite, porteiro. Agora eu sei o seu nome."
  }
 ],
