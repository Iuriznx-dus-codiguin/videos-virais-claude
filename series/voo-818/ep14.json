{
 "serie": "voo-818",
 "parte": 14,
 "titulo": "A escada",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Se alguém subir atrás de você numa escada escura, não corra."
  },
  {
   "id": "f2",
   "quem": "davi",
   "off": true,
   "texto": "Porque no escuro, quem tem lanterna aparece. E quem não tem, some."
  },
  {
   "id": "f3",
   "quem": "davi",
   "off": true,
   "texto": "Mas só se você não fizer luz nenhuma."
  },
  {
   "id": "f4",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "O alarme ainda grita lá embaixo quando as lanternas entram na torre."
  },
  {
   "id": "f5",
   "quem": "davi",
   "off": true,
   "texto": "O primeiro instinto da menina é sair correndo escada acima."
  },
  {
   "id": "f6",
   "quem": "davi",
   "off": true,
   "tom": "determinado",
   "texto": "Não. No escuro, um degrau errado é uma queda de vinte metros."
  },
  {
   "id": "f7",
   "quem": "davi",
   "off": true,
   "texto": "E as lanternas estão uns cinquenta degraus abaixo da gente. Subindo rápido."
  },
  {
   "id": "f8",
   "quem": "davi",
   "off": true,
   "texto": "Então, mão na parede, e cada degrau conta."
  },
  {
   "id": "f9",
   "quem": "lia",
   "tom": "sussurro",
   "texto": "Sessenta e um... sessenta e dois..."
  },
  {
   "id": "f10",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "E aí, de repente, as lanternas param. Ninguém sobe mais."
  },
  {
   "id": "f11",
   "quem": "valeria",
   "off": true,
   "tom": "calmo",
   "texto": "Deixa ele subir."
  },
  {
   "id": "f12",
   "quem": "davi",
   "off": true,
   "texto": "Era a voz do rádio. A mesma mulher que achou a gente na praia."
  },
  {
   "id": "f13",
   "quem": "lia",
   "tom": "sussurro",
   "texto": "Por que eles pararam?"
  },
  {
   "id": "f14",
   "quem": "davi",
   "off": true,
   "texto": "Eu não respondo, porque no meio da torre tem uma janela."
  },
  {
   "id": "f15",
   "quem": "davi",
   "off": true,
   "texto": "E contra o céu clareando, a gente vira dois alvos perfeitos."
  },
  {
   "id": "f16",
   "quem": "davi",
   "off": true,
   "texto": "Então a gente passa de joelhos, colado na parede, por baixo dela."
  },
  {
   "id": "f17",
   "quem": "davi",
   "off": true,
   "tom": "aliviado",
   "texto": "Cento e doze. A sala da lâmpada. A alavanca vermelha, a três passos."
  },
  {
   "id": "f18",
   "quem": "davi",
   "off": true,
   "tom": "aliviado",
   "texto": "Ninguém na sala. Ninguém na escada. Pela primeira vez, o farol era nosso."
  },
  {
   "id": "f19",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Só que, do outro lado da lente, alguém acendeu um isqueiro."
  },
  {
   "id": "f20",
   "quem": "ramos",
   "tom": "calmo",
   "texto": "Eu sabia que você vinha."
  }
 ],
