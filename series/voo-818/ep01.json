    },
    {
      "id": "f1",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Eu sou mecânico de avião. Eu SEI quando um avião não vai pousar.",
      "pausa_depois": 0.9
    },
    {
      "id": "f2",
      "quem": "davi",
      "off": true,
      "texto": "Acordei na areia, com cheiro de fumaça."
    },
    {
      "id": "f3",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Regra número um: longe dos destroços. Combustível pega FOGO."
    },
    {
      "id": "f4",
      "quem": "davi",
      "tom": "grito",
      "texto": "Tem alguém aí?!"
    },
    {
      "id": "f5",
      "quem": "lia",
      "tom": "grito",
      "texto": "Aqui! Eu tô aqui!",
      "pausa_depois": 0.3
    },
    {
      "id": "f6",
      "quem": "davi",
      "off": true,
      "tom": "aliviado",
      "texto": "Lia, treze anos. Viajava sozinha."
    },
    {
      "id": "f7",
      "quem": "davi",
      "off": true,
      "texto": "Dona Cida, setenta e nove anos. Enfermeira aposentada."
    },
    {
      "id": "f8",
      "quem": "cida",
      "tom": "calmo",
      "texto": "A perna não quebrou. Mas assim ele não vai longe."
    },
    {
      "id": "f9",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Otávio. Sou o copiloto."
    },
    {
      "id": "f10",
      "quem": "davi",
      "tom": "nervoso",
      "texto": "E o resto do pessoal?"
    },
    {
      "id": "f11",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Não sei.",
      "pausa_depois": 0.5
    },
    {
      "id": "f12",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Cento e quarenta e sete passageiros. E nem um corpo na praia."
    },
    {
      "id": "f13",
      "quem": "davi",
      "off": true,
      "texto": "Regra número dois: água antes de comida."
    },
    {
      "id": "f14",
      "quem": "davi",
      "off": true,
      "texto": "Juntei toda garrafa que achei nas malas."
    },
    {
      "id": "f15",
      "quem": "cida",
      "tom": "determinado",
      "texto": "Meio copo por pessoa. De manhã e de noite."
    },
    {
      "id": "f16",
      "quem": "davi",
      "off": true,
      "texto": "Regra número três: fogo antes de escurecer."
    },
    {
      "id": "s2",
      "silencio": 1.8
    },
    {
      "id": "f17",
      "quem": "lia",
      "tom": "medo",
      "texto": "E se ninguém vier buscar a gente?",
      "pausa_depois": 0.4
    },
    {
      "id": "f18",
      "quem": "valeria",
      "off": true,
      "tom": "calmo",
      "texto": "Voo 818, responda. Quantos sobreviventes?"
    },
    {
      "id": "f19",
      "quem": "davi",
      "tom": "animado",
      "texto": "Aqui! Nós somos..."
    },
    {
      "id": "f20",
      "quem": "valeria",
      "off": true,
      "tom": "calmo",
      "texto": "Davi Rocha... é você?",
      "pausa_depois": 0.5
    },
    {
      "id": "f21",
      "quem": "otavio",
      "tom": "bravo",
      "texto": "Não responde. Eles não estão procurando a gente."
    },
    {
      "id": "f22",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Estão procurando VOCÊ.",
      "pausa_depois": 0.3
    },
    {
      "id": "f23",
      "quem": "davi",
      "tom": "nervoso",
      "texto": "Como você sabe disso?"
    },
    {
      "id": "s3",
      "silencio": 1.0
    },
    {
      "id": "f24",
      "quem": "davi",
      "off": true,
      "tom": "sussurro",
      "texto": "A voz sabia o meu nome. E o copiloto... sabia de alguma coisa.",
      "pausa_depois": 0.6
