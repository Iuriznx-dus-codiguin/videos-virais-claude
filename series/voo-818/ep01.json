{
  "serie": "voo-818",
  "parte": 1,
  "titulo": "O único",
  "musica": "tensao",
  "falas": [
    {
      "id": "f1",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Eu estava no Voo 818, quando o avião começou a CAIR."
    },
    {
      "id": "f2",
      "quem": "davi",
      "off": true,
      "tom": "medo",
      "texto": "Fogo. Gritos. Um barulho que eu nunca mais vou esquecer."
    },
    {
      "id": "f3",
      "quem": "davi",
      "off": true,
      "tom": "triste",
      "texto": "E aí... tudo ficou preto.",
      "pausa_depois": 0.7
    },
    {
      "id": "f4",
      "quem": "davi",
      "off": true,
      "texto": "Quando abri os olhos, eu estava na areia, no meio dos destroços."
    },
    {
      "id": "f5",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Sou mecânico de aviões. E avião que cai não fica assim, quase INTEIRO."
    },
    {
      "id": "f6",
      "quem": "davi",
      "off": true,
      "texto": "Cento e quarenta e sete passageiros. E eu não achei NINGUÉM."
    },
    {
      "id": "f7",
      "quem": "davi",
      "off": true,
      "tom": "sussurro",
      "texto": "Nenhum ferido. Nenhum corpo. Só assentos vazios.",
      "pausa_depois": 0.4
    },
    {
      "id": "f8",
      "quem": "davi",
      "tom": "nervoso",
      "texto": "Ei! Tem alguém aí?!",
      "pausa_depois": 0.5
    },
    {
      "id": "f9",
      "quem": "davi",
      "off": true,
      "tom": "triste",
      "texto": "Ninguém respondeu. Só o mar."
    },
    {
      "id": "f9b",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "O sol já estava indo embora. E eu ainda não sabia onde eu estava."
    },
    {
      "id": "f10",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Foi aí que eu ouvi um chiado, vindo do rádio."
    },
    {
      "id": "f11",
      "quem": "valeria",
      "off": true,
      "tom": "calmo",
      "texto": "Voo 818, responda. Quantos sobreviventes?"
    },
    {
      "id": "f12",
      "quem": "davi",
      "off": true,
      "tom": "aliviado",
      "texto": "Eu quase chorei de alívio."
    },
    {
      "id": "f13",
      "quem": "davi",
      "tom": "nervoso",
      "texto": "Eu estou aqui! Só eu! Estou sozinho!",
      "pausa_depois": 0.7
    },
    {
      "id": "f14",
      "quem": "valeria",
      "off": true,
      "tom": "calmo",
      "texto": "Ótimo.",
      "pausa_depois": 0.8
    }
  ],
