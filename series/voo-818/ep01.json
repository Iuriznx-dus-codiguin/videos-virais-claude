{
  "serie": "voo-818",
  "parte": 1,
  "titulo": "A queda",
  "musica": "tensao",
  "falas": [
    {
      "id": "f1",
      "quem": "otavio",
      "off": true,
      "tom": "grito",
      "texto": "Aqui é o copiloto! Apertem os cintos. AGORA!"
    },
    {
      "id": "f2",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Sou mecânico de avião. Eu sei quando um barulho é normal."
    },
    {
      "id": "f3",
      "quem": "davi",
      "off": true,
      "tom": "medo",
      "texto": "E aquele barulho NÃO era normal."
    },
    {
      "id": "f4",
      "quem": "lia",
      "tom": "medo",
      "texto": "Moço... a gente vai cair?"
    },
    {
      "id": "f5",
      "quem": "cida",
      "tom": "calmo",
      "texto": "Segura a minha mão, filha. Respira comigo."
    },
    {
      "id": "f6",
      "quem": "davi",
      "off": true,
      "tom": "medo",
      "texto": "Foi a última coisa que eu ouvi antes do avião MERGULHAR."
    },
    {
      "id": "f7",
      "quem": "davi",
      "off": true,
      "tom": "triste",
      "texto": "E aí... tudo ficou preto.",
      "pausa_depois": 0.7
    },
    {
      "id": "f8",
      "quem": "davi",
      "off": true,
      "texto": "Acordei na areia, com cheiro de fumaça."
    },
    {
      "id": "f9",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Regra um: longe dos destroços. Combustível pega FOGO."
    },
    {
      "id": "f10",
      "quem": "davi",
      "tom": "grito",
      "texto": "Tem alguém aí?! Alguém me ouve?!"
    },
    {
      "id": "f11",
      "quem": "lia",
      "tom": "grito",
      "texto": "Aqui! Eu tô aqui!",
      "pausa_depois": 0.4
    },
    {
      "id": "f12",
      "quem": "davi",
      "off": true,
      "tom": "aliviado",
      "texto": "Era a Lia, a menina do avião. Treze anos."
    },
    {
      "id": "f13",
      "quem": "cida",
      "tom": "calmo",
      "texto": "Ninguém se feriu. Fui enfermeira quarenta anos."
    },
    {
      "id": "f14",
      "quem": "davi",
      "off": true,
      "texto": "Dona Cida, setenta e nove anos. Mais calma que eu."
    },
    {
      "id": "f15",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Otávio, copiloto. Quantos nós somos?"
    },
    {
      "id": "f16",
      "quem": "davi",
      "tom": "nervoso",
      "texto": "Quatro. Só QUATRO.",
      "pausa_depois": 0.4
    },
    {
      "id": "f17",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Cento e quarenta e sete passageiros. E mais NINGUÉM. Nem corpos."
    },
    {
      "id": "f18",
      "quem": "davi",
      "off": true,
      "texto": "Regra dois: água antes de comida. Juntamos as garrafas das malas."
    },
    {
      "id": "f19",
      "quem": "cida",
      "tom": "determinado",
      "texto": "E fogo antes da noite. Fogo chama resgate."
    },
    {
      "id": "f20",
      "quem": "davi",
      "off": true,
      "texto": "Alguém tinha um isqueiro na mala. Hoje, eu agradeço."
    },
    {
      "id": "f21",
      "quem": "lia",
      "tom": "medo",
      "texto": "E se ninguém vier buscar a gente?",
      "pausa_depois": 0.4
    },
    {
      "id": "f22",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Foi aí que o rádio de emergência chiou."
    },
    {
      "id": "f23",
      "quem": "valeria",
      "off": true,
      "tom": "calmo",
      "texto": "Voo 818, responda. Quantos sobreviventes?"
    },
    {
      "id": "f24",
      "quem": "davi",
      "tom": "animado",
      "texto": "Aqui! Nós somos..."
    },
    {
      "id": "f25",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Não responde.",
      "pausa_depois": 0.5
    },
    {
      "id": "f26",
      "quem": "davi",
      "off": true,
      "tom": "sussurro",
      "texto": "O copiloto desligou o rádio. Sem explicar NADA.",
      "pausa_depois": 0.8
    }
  ],
