{
 "serie": "voo-818",
 "parte": 13,
 "titulo": "O plano",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Se você escapar de um porão vigiado, não corra pra fora. Suba."
  },
  {
   "id": "f2",
   "quem": "davi",
   "off": true,
   "texto": "Porque lá em cima tem uma luz que o mar inteiro vê."
  },
  {
   "id": "f3",
   "quem": "davi",
   "off": true,
   "texto": "Mas só se ninguém perceber que você saiu."
  },
  {
   "id": "f4",
   "quem": "davi",
   "off": true,
   "texto": "Meu primeiro instinto é fugir pela praia e voltar com ajuda."
  },
  {
   "id": "f5",
   "quem": "davi",
   "off": true,
   "tom": "determinado",
   "texto": "Não. Quando a ajuda chegar, o barco já levou todo mundo."
  },
  {
   "id": "f6",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "E o Ramos desce às seis pra pegar a assinatura. Faltam QUATRO minutos."
  },
  {
   "id": "f7",
   "quem": "davi",
   "off": true,
   "texto": "Primeiro, a porta. Trancada por fora."
  },
  {
   "id": "f8",
   "quem": "lia",
   "tom": "sussurro",
   "texto": "A tranca é velha. Eu já abri uma vez."
  },
  {
   "id": "f8b",
   "quem": "davi",
   "off": true,
   "texto": "Treze anos e abre tranca. Melhor nem perguntar."
  },
  {
   "id": "f9",
   "quem": "davi",
   "off": true,
   "texto": "Foi assim que ela subiu sozinha, de madrugada, e piscou o farol."
  },
  {
   "id": "f10",
   "quem": "davi",
   "off": true,
   "texto": "E lá fora, eu só soube depois, o Otávio voltou. Com a Dona Cida."
  },
  {
   "id": "f11",
   "quem": "otavio",
   "tom": "serio",
   "texto": "Sem barco, ninguém sai daqui. Nem o ouro."
  },
  {
   "id": "f12",
   "quem": "cida",
   "tom": "calmo",
   "texto": "Então tira logo essa peça, que eu vigio."
  },
  {
   "id": "f13",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Só que, sem barco, o Ramos fica preso aqui com a gente."
  },
  {
   "id": "f14",
   "quem": "davi",
   "off": true,
   "texto": "E da última vez, eles cortaram a luz no meio da letra."
  },
  {
   "id": "f15",
   "quem": "lia",
   "tom": "determinado",
   "texto": "Dessa vez, você segura a alavanca. Eu vigio a escada."
  },
  {
   "id": "f16",
   "quem": "davi",
   "off": true,
   "texto": "Então a menina abre a tranca, a gente passa e começa a subir."
  },
  {
   "id": "f17",
   "quem": "davi",
   "off": true,
   "tom": "aliviado",
   "texto": "Cento e doze degraus. Nenhuma lanterna. Pela primeira vez, a gente está na frente."
  },
  {
   "id": "f18",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Só que o relógio bateu seis. E o Ramos desceu com a caneta."
  },
  {
   "id": "f19",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Acharam a porta ABERTA."
  }
 ],
