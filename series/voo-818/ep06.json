{
  "serie": "voo-818",
  "parte": 6,
  "titulo": "O que o Otávio ouviu",
  "musica": "tensao",
  "falas": [
    {
      "id": "f1",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Se alguém do seu grupo sabe demais, não acuse na frente dos outros."
    },
    {
      "id": "f2",
      "quem": "davi",
      "off": true,
      "texto": "Porque, longe dos outros, ninguém precisa fingir."
    },
    {
      "id": "f3",
      "quem": "davi",
      "off": true,
      "texto": "Mas só se você não espantar ele antes."
    },
    {
      "id": "f4",
      "quem": "davi",
      "off": true,
      "texto": "E o Otávio, o copiloto, sabe DEMAIS."
    },
    {
      "id": "f5",
      "quem": "davi",
      "off": true,
      "texto": "Ele sabia do rádio. Sabia da lista. E agora, até do farol."
    },
    {
      "id": "f6",
      "quem": "davi",
      "off": true,
      "texto": "Minha vontade é encarar ele ali mesmo, na frente de todo mundo."
    },
    {
      "id": "f7",
      "quem": "davi",
      "off": true,
      "tom": "serio",
      "texto": "Não. Encurralado e com plateia, ninguém confessa nada."
    },
    {
      "id": "f8",
      "quem": "otavio",
      "tom": "serio",
      "texto": "A jangada fica pronta em dois dias. Aí eu vou."
    },
    {
      "id": "f9",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Dois dias. Se ele for, o segredo vai junto.",
      "pausa_depois": 0.3
    },
    {
      "id": "f10",
      "quem": "davi",
      "off": true,
      "texto": "Então eu espero o fim da tarde, quando ele fica sozinho amarrando a jangada."
    },
    {
      "id": "f11",
      "quem": "davi",
      "tom": "serio",
      "texto": "Como você sabia que a voz do rádio me procurava?"
    },
    {
      "id": "f12",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Me trancaram fora da cabine. Cinco minutos antes da queda.",
      "pausa_depois": 0.3
    },
    {
      "id": "f13",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Copiloto trancado fora da própria cabine? Isso não existe."
    },
    {
      "id": "f14",
      "quem": "davi",
      "off": true,
      "texto": "Eu sou mecânico. Aquela porta só tranca por DENTRO."
    },
    {
      "id": "f15",
      "quem": "otavio",
      "tom": "nervoso",
      "texto": "Pela porta, eu ouvi o capitão falando com aquela voz do rádio.",
      "pausa_depois": 0.3
    },
    {
      "id": "f16",
      "quem": "davi",
      "off": true,
      "tom": "aliviado",
      "texto": "Então o Otávio não é inimigo. Só estava com medo, igual a gente."
    },
    {
      "id": "f17",
      "quem": "davi",
      "off": true,
      "texto": "A gente aperta a mão. Agora somos quatro de verdade.",
      "pausa_depois": 0.6
    },
    {
      "id": "f18",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Só que eu perguntei o que o capitão disse.",
      "pausa_depois": 0.4
    },
    {
      "id": "f19",
      "quem": "otavio",
      "tom": "sussurro",
      "texto": "Que pousou de propósito.",
      "pausa_depois": 0.4
    },
    {
      "id": "f20",
      "quem": "otavio",
      "tom": "sussurro",
      "texto": "E pediu pra deixar o MECÂNICO vivo.",
      "pausa_depois": 0.8
    }
  ],
