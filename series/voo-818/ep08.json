{
  "serie": "voo-818",
  "parte": 8,
  "titulo": "A vista",
  "musica": "tensao",
  "falas": [
    {
      "id": "f1",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Se você se perder numa ilha à noite, não ande pela mata. Suba."
    },
    {
      "id": "f2",
      "quem": "davi",
      "off": true,
      "texto": "Porque, lá de cima, no escuro, qualquer luz se entrega."
    },
    {
      "id": "f3",
      "quem": "davi",
      "off": true,
      "texto": "Mas só se a sua estiver apagada."
    },
    {
      "id": "f4",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "As botas que levaram a nossa Lia, de treze anos, sobem o morro."
    },
    {
      "id": "f5",
      "quem": "davi",
      "off": true,
      "texto": "E o meu primeiro instinto é correr atrás, de lanterna acesa."
    },
    {
      "id": "f6",
      "quem": "cida",
      "tom": "bravo",
      "texto": "Apaga isso, menino!"
    },
    {
      "id": "f7",
      "quem": "davi",
      "off": true,
      "tom": "serio",
      "texto": "Ela tem razão. Lanterna na mata grita: estou AQUI."
    },
    {
      "id": "f8",
      "quem": "otavio",
      "tom": "serio",
      "texto": "O sol nasce em duas horas. Depois, quem vira alvo é a gente."
    },
    {
      "id": "f9",
      "quem": "cida",
      "tom": "calmo",
      "texto": "Sem luz, espera dez minutos. O olho acostuma.",
      "semente": 102
    },
    {
      "id": "f10",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Dez minutos no escuro. E atrás do morro, uma buzina de barco.",
      "pausa_depois": 0.3
    },
    {
      "id": "f11",
      "quem": "davi",
      "off": true,
      "texto": "A trilha aparece. Só que a mata é cheia de folha seca."
    },
    {
      "id": "f12",
      "quem": "otavio",
      "tom": "sussurro",
      "texto": "Pisa na pedra, nunca na folha. Folha estala."
    },
    {
      "id": "f13",
      "quem": "davi",
      "off": true,
      "texto": "Ou seja, um morro inteiro em silêncio, com o Otávio mancando.",
      "pausa_depois": 0.3
    },
    {
      "id": "f14",
      "quem": "davi",
      "off": true,
      "texto": "No topo, dá pra ver tudo: um farol, um cais e um barco."
    },
    {
      "id": "f15",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Carregado de caixas. E nenhuma criança a bordo."
    },
    {
      "id": "f16",
      "quem": "otavio",
      "tom": "determinado",
      "texto": "Barco carregado de madrugada é gente indo EMBORA."
    },
    {
      "id": "f17",
      "quem": "cida",
      "tom": "aliviado",
      "texto": "Então é só esperar. Sem eles, a ilha é nossa."
    },
    {
      "id": "f18",
      "quem": "davi",
      "off": true,
      "tom": "aliviado",
      "texto": "E a gente procura a menina com calma, de dia.",
      "pausa_depois": 0.5
    },
    {
      "id": "f19",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Só que a luz do farol para de girar.",
      "pausa_depois": 0.4
    },
    {
      "id": "f20",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "E começa a piscar. Três curtas. Três longas. Três curtas.",
      "pausa_depois": 0.3
    },
    {
      "id": "f21",
      "quem": "otavio",
      "tom": "medo",
      "texto": "É um pedido de SOCORRO.",
      "pausa_depois": 0.8
    }
  ],
