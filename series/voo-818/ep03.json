{
  "serie": "voo-818",
  "parte": 3,
  "titulo": "A jangada",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "davi",
      "off": true,
      "tom": "sussurro",
      "texto": "Eu não tive coragem de virar."
    },
    {
      "id": "f2",
      "quem": "otavio",
      "tom": "serio",
      "texto": "O meu nome também está aí. Eu já tinha visto."
    },
    {
      "id": "f3",
      "quem": "davi",
      "tom": "bravo",
      "texto": "E não ia contar pra NINGUÉM?"
    },
    {
      "id": "f4",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Quem circulou esses nomes vai voltar. Pra conferir."
    },
    {
      "id": "f4b",
      "quem": "otavio",
      "tom": "determinado",
      "texto": "Amanhã cedo, a gente começa a jangada.",
      "pausa_depois": 0.4
    },
    {
      "id": "f5",
      "quem": "davi",
      "off": true,
      "texto": "De manhã, o Otávio fez as contas na frente de todo mundo."
    },
    {
      "id": "f6",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Comida pra cinco dias. Se fosse resgate, já tinha chegado."
    },
    {
      "id": "f7",
      "quem": "cida",
      "tom": "calmo",
      "texto": "Resgate procura primeiro onde o avião caiu. A gente fica e faz sinal."
    },
    {
      "id": "f8",
      "quem": "otavio",
      "tom": "bravo",
      "texto": "E se quem vier NÃO for resgate?",
      "pausa_depois": 0.4
    },
    {
      "id": "f9",
      "quem": "davi",
      "off": true,
      "texto": "Regra número quatro: sinal que se vê do céu. A Dona Cida fez um SOS de pedra."
    },
    {
      "id": "f9b",
      "quem": "lia",
      "tom": "nervoso",
      "texto": "E se ninguém olhar pra baixo?"
    },
    {
      "id": "f9c",
      "quem": "cida",
      "tom": "calmo",
      "texto": "Alguém sempre olha, minha filha."
    },
    {
      "id": "f10",
      "quem": "davi",
      "off": true,
      "texto": "E o Otávio, mancando, começou a jangada com os troncos da praia."
    },
    {
      "id": "f10b",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Corda, a gente tinha. Cento e quarenta e sete cintos."
    },
    {
      "id": "f11",
      "quem": "lia",
      "tom": "medo",
      "texto": "Eu não subo nisso. Um tubarão vira essa coisa fácil."
    },
    {
      "id": "f12",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Então fica esperando na praia. Eu vou."
    },
    {
      "id": "f13",
      "quem": "lia",
      "tom": "bravo",
      "texto": "Não! Deixa EU fazer a jangada. Uma que não vira."
    },
    {
      "id": "f14",
      "quem": "lia",
      "tom": "determinado",
      "texto": "E a gente testa aqui na beira primeiro."
    },
    {
      "id": "f15",
      "quem": "davi",
      "off": true,
      "texto": "Treze anos, dando ordem no copiloto. Eu gostei dela.",
      "pausa_depois": 0.5
    },
    {
      "id": "f16",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Mas naquela noite... a mata ACENDEU.",
      "pausa_depois": 0.6
    },
    {
      "id": "f17",
      "quem": "lia",
      "tom": "sussurro",
      "texto": "Davi... tem gente lá.",
      "pausa_depois": 0.3
    },
    {
      "id": "f18",
      "quem": "davi",
      "off": true,
      "tom": "medo",
      "texto": "E as luzes vinham direto pro nosso fogo.",
      "pausa_depois": 0.8
    }
  ],
