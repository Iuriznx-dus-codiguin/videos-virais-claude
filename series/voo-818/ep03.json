{
  "serie": "voo-818",
  "parte": 3,
  "titulo": "A jangada",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Se o seu avião cair numa ilha, não tente fugir pelo mar."
    },
    {
      "id": "f2",
      "quem": "davi",
      "off": true,
      "texto": "Porque um avião caído é a coisa mais fácil de achar lá de cima."
    },
    {
      "id": "f3",
      "quem": "davi",
      "off": true,
      "texto": "Mas só se ninguém do grupo fizer besteira."
    },
    {
      "id": "f4",
      "quem": "davi",
      "off": true,
      "texto": "E o Otávio, o copiloto, quer fugir amanhã cedo. De jangada."
    },
    {
      "id": "f5",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Eu já tinha visto aquela lista."
    },
    {
      "id": "f6",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Quem circulou os nomes vai voltar pra conferir."
    },
    {
      "id": "f7",
      "quem": "davi",
      "off": true,
      "tom": "serio",
      "texto": "Não. Lá de cima, jangada é um pontinho. E pontinho ninguém acha."
    },
    {
      "id": "f8",
      "quem": "otavio",
      "tom": "bravo",
      "texto": "Comida pra cinco dias, Davi. Faz a conta."
    },
    {
      "id": "f9",
      "quem": "davi",
      "off": true,
      "texto": "Então a Dona Cida faz um SOS de pedra na areia.",
      "semente": 102
    },
    {
      "id": "f10",
      "quem": "lia",
      "tom": "nervoso",
      "texto": "E se ninguém olhar pra baixo?"
    },
    {
      "id": "f11",
      "quem": "cida",
      "tom": "calmo",
      "texto": "Alguém sempre olha, minha filha.",
      "pausa_depois": 0.3
    },
    {
      "id": "f12",
      "quem": "davi",
      "off": true,
      "texto": "Mas o Otávio não espera e começa a jangada."
    },
    {
      "id": "f13",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Corda? Cento e quarenta e sete cintos."
    },
    {
      "id": "f14",
      "quem": "lia",
      "tom": "medo",
      "texto": "Eu não subo nisso. Tubarão vira essa coisa fácil."
    },
    {
      "id": "f15",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Então fica na praia. Eu vou sozinho."
    },
    {
      "id": "f16",
      "quem": "lia",
      "tom": "bravo",
      "texto": "Não! Deixa EU fazer uma que não vira."
    },
    {
      "id": "f17",
      "quem": "davi",
      "off": true,
      "texto": "Treze anos, mandando no copiloto. Gostei da Lia.",
      "pausa_depois": 0.5
    },
    {
      "id": "f18",
      "quem": "davi",
      "off": true,
      "texto": "De noite, ninguém vê pedra. O sinal é o fogo."
    },
    {
      "id": "f19",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "E fogo se vê de muito longe.",
      "pausa_depois": 0.5
    },
    {
      "id": "f20",
      "quem": "davi",
      "off": true,
      "tom": "aliviado",
      "texto": "Sinal de pedra, fogo aceso e meia jangada."
    },
    {
      "id": "f21",
      "quem": "davi",
      "off": true,
      "texto": "Pela primeira vez, parecia que ia dar certo.",
      "pausa_depois": 0.7
    },
    {
      "id": "f22",
      "quem": "lia",
      "tom": "sussurro",
      "texto": "Davi... tem luz na mata.",
      "pausa_depois": 0.3
    },
    {
      "id": "f23",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Resgate vem pelo céu ou pelo mar.",
      "pausa_depois": 0.4
    },
    {
      "id": "f24",
      "quem": "davi",
      "off": true,
      "tom": "medo",
      "texto": "Aquelas luzes vinham de DENTRO da ilha.",
      "pausa_depois": 0.8
    }
  ],
