{
  "serie": "voo-818",
  "parte": 4,
  "titulo": "Lanternas",
  "musica": "tensao",
  "falas": [
    {
      "id": "f1",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Se você vir lanternas numa ilha deserta, não grite por socorro."
    },
    {
      "id": "f2",
      "quem": "davi",
      "off": true,
      "texto": "Porque no escuro, quem fica parado vê antes de ser visto."
    },
    {
      "id": "f3",
      "quem": "davi",
      "off": true,
      "texto": "Mas só se a sua fogueira não te entregar antes."
    },
    {
      "id": "f4",
      "quem": "davi",
      "off": true,
      "texto": "O primeiro instinto da Lia é correr até elas.",
      "semente": 102
    },
    {
      "id": "f5",
      "quem": "lia",
      "tom": "animado",
      "texto": "Resgate! Eles vieram buscar a gente!"
    },
    {
      "id": "f6",
      "quem": "davi",
      "off": true,
      "tom": "serio",
      "texto": "Não. Resgate não chega pela mata."
    },
    {
      "id": "f7",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "E usa colete LARANJA, a cor que riscou a lista de passageiros."
    },
    {
      "id": "f8",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Dois minutos, e eles estão no nosso fogo."
    },
    {
      "id": "f9",
      "quem": "davi",
      "off": true,
      "texto": "Primeiro, o fogo. Ele mostra onde a gente está."
    },
    {
      "id": "f10",
      "quem": "davi",
      "off": true,
      "texto": "Areia em cima, e a praia inteira fica preta.",
      "pausa_depois": 0.3
    },
    {
      "id": "f11",
      "quem": "davi",
      "off": true,
      "texto": "Agora, esconder. A árvore grande tem raízes do tamanho de um carro."
    },
    {
      "id": "f12",
      "quem": "davi",
      "off": true,
      "texto": "Mas o Otávio, de perna machucada, não corre."
    },
    {
      "id": "f13",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Vão sem mim. Eu atraso vocês."
    },
    {
      "id": "f14",
      "quem": "davi",
      "tom": "determinado",
      "texto": "Ninguém fica pra trás. Apoia em mim."
    },
    {
      "id": "f15",
      "quem": "davi",
      "off": true,
      "texto": "A Dona Cida, setenta e nove anos, chega primeiro.",
      "pausa_depois": 0.4
    },
    {
      "id": "f16",
      "quem": "davi",
      "off": true,
      "texto": "Lá dentro, outro problema: a Lia respira alto de medo.",
      "semente": 203
    },
    {
      "id": "f17",
      "quem": "cida",
      "tom": "sussurro",
      "texto": "Respira comigo, minha filha. Devagar.",
      "pausa_depois": 0.3
    },
    {
      "id": "f18",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Três lanternas lá fora. Quatro pessoas sem fazer barulho."
    },
    {
      "id": "f19",
      "quem": "davi",
      "off": true,
      "texto": "Eles iluminam a jangada, o sinal de pedra e o fogo apagado."
    },
    {
      "id": "f20",
      "quem": "davi",
      "off": true,
      "tom": "aliviado",
      "texto": "E voltam pra mata. Ninguém viu a gente.",
      "pausa_depois": 0.6
    },
    {
      "id": "f21",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Só que o último parou bem na frente das raízes.",
      "pausa_depois": 0.4
    },
    {
      "id": "f22",
      "quem": "davi",
      "off": true,
      "tom": "sussurro",
      "texto": "Um... dois... três... quatro.",
      "pausa_depois": 0.4
    },
    {
      "id": "f23",
      "quem": "davi",
      "off": true,
      "tom": "medo",
      "texto": "Ele não procurava sobreviventes. Estava CONTANDO.",
      "pausa_depois": 0.8
    }
  ],
