{
 "serie": "voo-818",
 "parte": 12,
 "titulo": "A adega",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Se te trancarem num porão cheio de gente dormindo, não acorde ninguém."
  },
  {
   "id": "f2",
   "quem": "davi",
   "off": true,
   "texto": "Porque, no meio de quem dorme, ninguém repara em mais um."
  },
  {
   "id": "f3",
   "quem": "davi",
   "off": true,
   "texto": "Mas só se você não fizer barulho."
  },
  {
   "id": "f4",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Cento e quarenta e três passageiros do meu voo. VIVOS."
  },
  {
   "id": "f5",
   "quem": "davi",
   "off": true,
   "tom": "determinado",
   "texto": "Eu exigi ver a menina antes de assinar."
  },
  {
   "id": "f6",
   "quem": "davi",
   "off": true,
   "texto": "Então o Ramos me jogou aqui."
  },
  {
   "id": "f7",
   "quem": "davi",
   "off": true,
   "texto": "Meu primeiro instinto é gritar o nome dela."
  },
  {
   "id": "f8",
   "quem": "davi",
   "off": true,
   "tom": "determinado",
   "texto": "Não. Grito aqui embaixo sobe a escada inteira.",
   "semente": 102
  },
  {
   "id": "f9",
   "quem": "davi",
   "off": true,
   "texto": "De hora em hora, um deles desce pra contar cabeça. Faltam dez minutos."
  },
  {
   "id": "f10",
   "quem": "davi",
   "off": true,
   "texto": "Primeiro, achar uma menina no meio de todo mundo."
  },
  {
   "id": "f11",
   "quem": "davi",
   "off": true,
   "texto": "Lá atrás, encostada no barril... é a Lia."
  },
  {
   "id": "f12",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Só que ela não acorda. Respira devagar, igual aos outros."
  },
  {
   "id": "f13",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "E aí eu sinto o cheiro. O ar daqui de baixo é DOCE."
  },
  {
   "id": "f14",
   "quem": "davi",
   "off": true,
   "texto": "Ou seja, ainda tem gás aqui. E eu já estou com sono."
  },
  {
   "id": "f15",
   "quem": "davi",
   "off": true,
   "texto": "Ar limpo só entra por um lugar: a fresta da porta."
  },
  {
   "id": "f16",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Mas é exatamente por essa porta que a contagem desce."
  },
  {
   "id": "f17",
   "quem": "davi",
   "off": true,
   "texto": "Então eu sento no chão, fecho os olhos e respiro pela fresta."
  },
  {
   "id": "f18",
   "quem": "davi",
   "off": true,
   "tom": "aliviado",
   "texto": "A lanterna passa no meu rosto, conta cento e quarenta e quatro e sobe. Passou."
  },
  {
   "id": "f19",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Só que a pessoa do meu lado falou sem abrir o olho."
  },
  {
   "id": "f20",
   "quem": "lia",
   "tom": "sussurro",
   "texto": "Fui eu que pisquei o farol, Davi."
  },
  {
   "id": "f21",
   "quem": "lia",
   "tom": "determinado",
   "texto": "Dessa vez, o mundo inteiro vai ver."
  }
 ],
