{
  "serie": "voo-818",
  "parte": 5,
  "titulo": "Água doce",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Se a sua água acabar numa ilha, não procure um rio."
    },
    {
      "id": "f2",
      "quem": "davi",
      "off": true,
      "texto": "Porque a água doce pode estar debaixo dos seus pés."
    },
    {
      "id": "f3",
      "quem": "davi",
      "off": true,
      "texto": "Mas só se você cavar no lugar CERTO."
    },
    {
      "id": "f4",
      "quem": "davi",
      "off": true,
      "texto": "O Otávio, o copiloto, quer entrar na mata atrás de um riacho."
    },
    {
      "id": "f5",
      "quem": "davi",
      "off": true,
      "tom": "serio",
      "texto": "Não. Foi pra mata que voltaram os homens que contaram a gente."
    },
    {
      "id": "f6",
      "quem": "otavio",
      "tom": "bravo",
      "texto": "Duas garrafas pra quatro pessoas, Davi."
    },
    {
      "id": "f7",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "No calor, isso não dura até amanhã."
    },
    {
      "id": "f8",
      "quem": "cida",
      "tom": "calmo",
      "texto": "Cava atrás da areia seca, onde começa o mato."
    },
    {
      "id": "f9",
      "quem": "davi",
      "off": true,
      "texto": "Meio metro pra baixo, a areia fica molhada. E a água brota."
    },
    {
      "id": "f10",
      "quem": "lia",
      "tom": "nervoso",
      "texto": "Tá salgada?"
    },
    {
      "id": "f11",
      "quem": "cida",
      "tom": "calmo",
      "texto": "Quase nada. Mas pode ter bicho. Tem que ferver.",
      "pausa_depois": 0.3
    },
    {
      "id": "f12",
      "quem": "davi",
      "off": true,
      "texto": "Ou seja, a água tá ali. Mas pra ferver, precisa de fogo."
    },
    {
      "id": "f13",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Só que fogo de dia faz fumaça. E fumaça mostra onde a gente está."
    },
    {
      "id": "f14",
      "quem": "cida",
      "tom": "calmo",
      "texto": "Só galho seco, Lia. Galho verde é que faz fumaça."
    },
    {
      "id": "f15",
      "quem": "davi",
      "off": true,
      "texto": "E a Lia junta galho seco como se fosse campeonato.",
      "pausa_depois": 0.5
    },
    {
      "id": "f16",
      "quem": "davi",
      "off": true,
      "texto": "De noite, a gente vigia em dupla, de olho na mata."
    },
    {
      "id": "f17",
      "quem": "davi",
      "off": true,
      "tom": "aliviado",
      "texto": "Seis garrafas cheias, fogo baixinho e nenhuma lanterna na mata."
    },
    {
      "id": "f18",
      "quem": "davi",
      "off": true,
      "texto": "Dava pra aguentar uma semana ali.",
      "pausa_depois": 0.6
    },
    {
      "id": "f19",
      "quem": "lia",
      "tom": "animado",
      "texto": "Davi, olha! Uma luz girando no mar!"
    },
    {
      "id": "f20",
      "quem": "lia",
      "tom": "animado",
      "texto": "É um farol! Tem gente lá!",
      "pausa_depois": 0.4
    },
    {
      "id": "f21",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Só que o Otávio voa por essas águas há quinze anos.",
      "pausa_depois": 0.3
    },
    {
      "id": "f22",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Nenhum mapa tem FAROL nesta ilha.",
      "pausa_depois": 0.8
    }
  ],
