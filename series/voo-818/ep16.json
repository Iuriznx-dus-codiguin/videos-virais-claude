{
 "serie": "voo-818",
 "parte": 16,
 "titulo": "A caixa preta",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Se alguém derrubou o seu avião de propósito, não perca tempo acusando ninguém."
  },
  {
   "id": "f2",
   "quem": "davi",
   "off": true,
   "texto": "Porque todo avião leva uma testemunha que nunca mente."
  },
  {
   "id": "f3",
   "quem": "davi",
   "off": true,
   "texto": "Mas só se você chegar nela antes do culpado."
  },
  {
   "id": "f4",
   "quem": "davi",
   "off": true,
   "texto": "O raio apagou o farol, e meu primeiro instinto é religar."
  },
  {
   "id": "f5",
   "quem": "davi",
   "off": true,
   "tom": "determinado",
   "texto": "Não. Religar leva minutos. As lanternas chegam em segundos."
  },
  {
   "id": "f6",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Então a gente cola na parede, atrás da porta."
  },
  {
   "id": "f7",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "E as lanternas passam a um palmo da gente."
  },
  {
   "id": "f8",
   "quem": "lia",
   "tom": "sussurro",
   "texto": "Agora. Desce."
  },
  {
   "id": "f9",
   "quem": "davi",
   "off": true,
   "texto": "Lá embaixo, no cais, o Otávio e a Dona Cida esperam no escuro."
  },
  {
   "id": "f10",
   "quem": "otavio",
   "tom": "determinado",
   "texto": "A caixa preta gravou o Ramos combinando tudo."
  },
  {
   "id": "f11",
   "quem": "davi",
   "off": true,
   "texto": "A caixa preta fica na cauda, a parte que mais aguenta a queda."
  },
  {
   "id": "f12",
   "quem": "davi",
   "off": true,
   "texto": "E a cauda está do outro lado da ilha. Uns dois quilômetros."
  },
  {
   "id": "f13",
   "quem": "cida",
   "tom": "calmo",
   "texto": "Vai pela beira d'água. Lá não fica pegada."
  },
  {
   "id": "f14",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "E o Ramos também sabe dela."
  },
  {
   "id": "f15",
   "quem": "davi",
   "off": true,
   "texto": "Então eu corro sozinho, no escuro, com o mar apagando meus passos."
  },
  {
   "id": "f16",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "E quando eu chego na cauda, ela está aberta."
  },
  {
   "id": "f17",
   "quem": "davi",
   "off": true,
   "texto": "Mas lá dentro, alguma coisa apita."
  },
  {
   "id": "f18",
   "quem": "davi",
   "off": true,
   "texto": "É a caixa preta. Que, aliás, é laranja."
  },
  {
   "id": "f19",
   "quem": "davi",
   "off": true,
   "tom": "aliviado",
   "texto": "Agora a gente tinha a prova, e ela estava na minha mão."
  },
  {
   "id": "f20",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Só que aquele pedido de socorro do farol foi visto, sim."
  },
  {
   "id": "f21",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Faróis de barco vêm direto pra praia."
  },
  {
   "id": "f22",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "E não era a Marinha."
  }
 ],
