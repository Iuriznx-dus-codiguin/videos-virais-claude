  "falas": [
    { "id": "f1", "quem": "davi", "off": true, "tom": "tenso", "texto": "Ótimo. Ela disse ÓTIMO. Quem fica feliz com um sobrevivente só?" },
    { "id": "f2", "quem": "davi", "tom": "nervoso", "texto": "Alô? Quem é você? Manda ajuda!", "pausa_depois": 0.5 },
    { "id": "f3", "quem": "davi", "off": true, "texto": "O rádio ficou mudo. Então eu fiz o que mecânico faz: fui olhar por DENTRO." },
    { "id": "f4", "quem": "davi", "off": true, "tom": "sussurro", "texto": "Lá dentro, as luzes ainda estavam acesas." },
    { "id": "f5", "quem": "davi", "off": true, "tom": "tenso", "texto": "Cento e quarenta e sete cintos. Todos ABERTOS." },
    { "id": "f6", "quem": "davi", "off": true, "texto": "Ninguém solta o cinto com o avião caindo. Alguém soltou DEPOIS." },
    { "id": "f7", "quem": "davi", "off": true, "tom": "medo", "texto": "E os celulares nos bancos... tocando, todos ao mesmo tempo.", "pausa_depois": 0.4 },
    { "id": "f8", "quem": "davi", "off": true, "texto": "Primeira vez que eu vejo um avião sem fila pro banheiro." },
    { "id": "f9", "quem": "davi", "off": true, "tom": "tenso", "texto": "Aí eu vi uma prancheta num assento. O manifesto do voo." },
    { "id": "f10", "quem": "davi", "off": true, "texto": "A lista com o nome de todos os passageiros." },
    { "id": "f11", "quem": "davi", "off": true, "tom": "tenso", "texto": "Todos riscados. De LARANJA." },
    { "id": "f12", "quem": "davi", "off": true, "tom": "sussurro", "texto": "Menos um. Circulado de VERMELHO.", "pausa_depois": 0.4 },
    { "id": "f13", "quem": "davi", "tom": "medo", "texto": "Rocha, D. Assento trinta e um C... Sou EU.", "pausa_depois": 0.6 },
    { "id": "f14", "quem": "davi", "off": true, "tom": "sussurro", "texto": "Alguém sabia onde eu estava sentado.", "pausa_depois": 0.8 }
