{
  "serie": "voo-818",
  "parte": 2,
  "titulo": "Assentos vazios",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "davi",
      "tom": "bravo",
      "texto": "Como você sabia que era EU?"
    },
    {
      "id": "f2",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Resgate pergunta ONDE a gente está. Não pergunta NOME."
    },
    {
      "id": "f3",
      "quem": "cida",
      "tom": "calmo",
      "texto": "Ninguém resolve nada de cabeça quente. Amanhã a gente pensa."
    },
    {
      "id": "f4",
      "quem": "lia",
      "tom": "medo",
      "texto": "Eu não vou dormir perto do mar. Tem tubarão."
    },
    {
      "id": "f4b",
      "quem": "otavio",
      "tom": "determinado",
      "texto": "Amanhã a gente começa uma jangada. Nem que eu vá mancando."
    },
    {
      "id": "f4c",
      "quem": "lia",
      "tom": "grito",
      "texto": "Jangada? No MAR? Nem pensar!",
      "pausa_depois": 0.4
    },
    {
      "id": "f5",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Eu fingi que dormi. Quando todo mundo apagou, eu voltei pro avião.",
      "pausa_depois": 0.4
    },
    {
      "id": "f6",
      "quem": "davi",
      "off": true,
      "tom": "sussurro",
      "texto": "Lá dentro, as luzes de emergência ainda estavam acesas."
    },
    {
      "id": "f7",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Cento e quarenta e sete cintos. Todos ABERTOS."
    },
    {
      "id": "f8",
      "quem": "davi",
      "off": true,
      "texto": "Ninguém solta o cinto com o avião caindo. Alguém soltou DEPOIS."
    },
    {
      "id": "f9",
      "quem": "davi",
      "off": true,
      "tom": "medo",
      "texto": "E os celulares nos bancos... tocando, todos ao mesmo tempo.",
      "pausa_depois": 0.4
    },
    {
      "id": "f10",
      "quem": "davi",
      "off": true,
      "texto": "Primeira vez que eu vejo um avião sem fila pro banheiro."
    },
    {
      "id": "f11",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Aí eu vi uma prancheta num assento. O manifesto do voo."
    },
    {
      "id": "f12",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Os nomes de todos os passageiros. Riscados de LARANJA."
    },
    {
      "id": "f13",
      "quem": "davi",
      "off": true,
      "tom": "sussurro",
      "texto": "Menos quatro. Circulados de VERMELHO.",
      "pausa_depois": 0.4
    },
    {
      "id": "f14",
      "quem": "davi",
      "tom": "medo",
      "texto": "Rocha, Davi. Lia Martins. Aparecida Souza. E Otávio Lemos, copiloto."
    },
    {
      "id": "f15",
      "quem": "davi",
      "off": true,
      "tom": "medo",
      "texto": "Os quatro que sobreviveram. Alguém sabia QUEM ia sobreviver.",
      "pausa_depois": 0.5
    },
    {
      "id": "f16",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Achou o que estava procurando, Davi?",
      "pausa_depois": 0.8
    }
  ],
