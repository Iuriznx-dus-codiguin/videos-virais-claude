{
  "serie": "voo-818",
  "parte": 7,
  "titulo": "Pegadas",
  "musica": "tensao",
  "falas": [
    {
      "id": "f1",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Se alguém do seu grupo sumir de madrugada, não saia gritando o nome dela."
    },
    {
      "id": "f2",
      "quem": "davi",
      "off": true,
      "texto": "Porque a areia conta pra onde ela foi."
    },
    {
      "id": "f3",
      "quem": "davi",
      "off": true,
      "texto": "Mas só se ninguém pisar em cima antes."
    },
    {
      "id": "f4",
      "quem": "davi",
      "off": true,
      "texto": "Ontem eu descobri: o capitão derrubou o avião de propósito."
    },
    {
      "id": "f5",
      "quem": "davi",
      "off": true,
      "texto": "E eu sou o único que ele quer VIVO."
    },
    {
      "id": "f6",
      "quem": "cida",
      "tom": "serio",
      "texto": "Então ninguém vai pro farol. Nem você, Davi."
    },
    {
      "id": "f7",
      "quem": "otavio",
      "tom": "determinado",
      "texto": "A jangada sai amanhã. Com todo mundo.",
      "pausa_depois": 0.3
    },
    {
      "id": "f8",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Só que, de madrugada, a Lia some.",
      "pausa_depois": 0.3
    },
    {
      "id": "f9",
      "quem": "otavio",
      "tom": "medo",
      "texto": "Lia! LIA!"
    },
    {
      "id": "f10",
      "quem": "davi",
      "off": true,
      "tom": "serio",
      "texto": "Não. Grito acorda quem não devia. E cada passo dele apaga um dela."
    },
    {
      "id": "f11",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "E a maré sobe em uma hora. Água apaga qualquer pegada."
    },
    {
      "id": "f12",
      "quem": "davi",
      "off": true,
      "texto": "Ou seja, a gente tem uma hora pra achar a Lia pelo chão."
    },
    {
      "id": "f13",
      "quem": "cida",
      "tom": "calmo",
      "texto": "Lanterna baixa, rente ao chão. A sombra mostra o pé."
    },
    {
      "id": "f14",
      "quem": "davi",
      "off": true,
      "texto": "E as pegadas da Lia aparecem. Pequenas, descalças."
    },
    {
      "id": "f15",
      "quem": "davi",
      "off": true,
      "texto": "Elas vão até a jangada que ela mesma estava fazendo."
    },
    {
      "id": "f16",
      "quem": "davi",
      "off": true,
      "texto": "Metade pronta. E um nó que só ela sabe dar."
    },
    {
      "id": "f17",
      "quem": "otavio",
      "tom": "nervoso",
      "texto": "Ela foi pro mar sozinha? Com medo de tubarão?"
    },
    {
      "id": "f18",
      "quem": "davi",
      "off": true,
      "texto": "Não. As pegadas voltam pra mata.",
      "pausa_depois": 0.3
    },
    {
      "id": "f19",
      "quem": "cida",
      "tom": "calmo",
      "texto": "Ela foi buscar galho. Essa menina é esperta."
    },
    {
      "id": "f20",
      "quem": "davi",
      "off": true,
      "tom": "aliviado",
      "texto": "Faz sentido. A gente segue a trilha, devagar, sem pressa.",
      "pausa_depois": 0.5
    },
    {
      "id": "f21",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Só que, no meio da trilha, as pegadinhas param.",
      "pausa_depois": 0.4
    },
    {
      "id": "f22",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "No lugar delas, pegadas de BOTA.",
      "pausa_depois": 0.3
    },
    {
      "id": "f23",
      "quem": "davi",
      "off": true,
      "tom": "medo",
      "texto": "Alguém levou a Lia.",
      "pausa_depois": 0.8
    }
  ],
