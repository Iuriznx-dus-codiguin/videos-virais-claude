{
 "serie": "voo-818",
 "parte": 18,
 "titulo": "Resgate",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Se quem derrubou o seu avião perguntar quantos sobreviveram, não diga a verdade."
  },
  {
   "id": "f2",
   "quem": "davi",
   "off": true,
   "texto": "Porque esse número decide quem volta pra casa."
  },
  {
   "id": "f3",
   "quem": "davi",
   "off": true,
   "texto": "E na lista da Valéria, só o MECÂNICO precisa voltar vivo."
  },
  {
   "id": "f4",
   "quem": "valeria",
   "tom": "calmo",
   "texto": "Quantos, Davi?"
  },
  {
   "id": "f5",
   "quem": "davi",
   "off": true,
   "texto": "Meu primeiro instinto é dizer: só eu sobrevivi."
  },
  {
   "id": "f6",
   "quem": "davi",
   "off": true,
   "tom": "determinado",
   "texto": "Não. Se for só eu, ninguém procura os outros."
  },
  {
   "id": "f7",
   "quem": "davi",
   "tom": "determinado",
   "texto": "Cento e quarenta e sete. Todo mundo vivo."
  },
  {
   "id": "f8",
   "quem": "valeria",
   "tom": "calmo",
   "texto": "Ninguém acredita num mecânico, Davi."
  },
  {
   "id": "f9",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Só que a prova está enterrada a dois passos do meu pé."
  },
  {
   "id": "f10",
   "quem": "davi",
   "off": true,
   "texto": "E os homens dela já reviram a areia com lanterna."
  },
  {
   "id": "f11",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Em dez minutos clareia. Com luz, eles acham a caixa."
  },
  {
   "id": "f12",
   "quem": "davi",
   "off": true,
   "texto": "Se eu olhar pro chão, eu entrego. Eu olho pro mar."
  },
  {
   "id": "f13",
   "quem": "davi",
   "off": true,
   "texto": "Lá longe, uma luz enorme vem pelo mar. É a MARINHA."
  },
  {
   "id": "f14",
   "quem": "valeria",
   "tom": "bravo",
   "texto": "Isso não acabou."
  },
  {
   "id": "f15",
   "quem": "davi",
   "off": true,
   "texto": "Ela corre pro barco e some."
  },
  {
   "id": "f16",
   "quem": "davi",
   "off": true,
   "texto": "No farol, o Capitão Ramos sai com as mãos na cabeça."
  },
  {
   "id": "f17",
   "quem": "davi",
   "off": true,
   "texto": "A Dona Cida abre a adega, e entra ar fresco."
  },
  {
   "id": "f18",
   "quem": "davi",
   "off": true,
   "tom": "aliviado",
   "texto": "Cento e quarenta e três pessoas abrem os olhos."
  },
  {
   "id": "f19",
   "quem": "lia",
   "tom": "feliz",
   "texto": "Davi! A gente vai pra casa!"
  },
  {
   "id": "f20",
   "quem": "davi",
   "off": true,
   "texto": "Três meses depois, a caixa preta prendeu o Ramos. Só ele."
  },
  {
   "id": "f21",
   "quem": "davi",
   "off": true,
   "texto": "No hangar, eu vejo a Valéria no jornal. Como heroína."
  },
  {
   "id": "f22",
   "quem": "valeria",
   "tom": "calmo",
   "texto": "Eu nunca desisti daqueles passageiros."
  },
  {
   "id": "f23",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Ela sorriu pra câmera. Mas a caixa preta também gravou a voz dela."
  }
 ],
