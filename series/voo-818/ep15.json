{
 "serie": "voo-818",
 "parte": 15,
 "titulo": "A tempestade",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Se quem te prendeu estiver entre você e a alavanca do socorro, não pule nele."
  },
  {
   "id": "f2",
   "quem": "davi",
   "off": true,
   "texto": "Porque numa tempestade, todo barco no mar procura um farol."
  },
  {
   "id": "f3",
   "quem": "davi",
   "off": true,
   "texto": "Mas só se essa luz ficar acesa até alguém ver."
  },
  {
   "id": "f4",
   "quem": "davi",
   "off": true,
   "texto": "Meu primeiro instinto é pular na alavanca vermelha."
  },
  {
   "id": "f5",
   "quem": "davi",
   "off": true,
   "tom": "determinado",
   "texto": "Não. O piloto que derrubou o nosso avião está a um passo dela."
  },
  {
   "id": "f6",
   "quem": "ramos",
   "tom": "calmo",
   "texto": "Senta aí, mecânico. Lá embaixo tem seis homens."
  },
  {
   "id": "f7",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Cento e doze degraus. Correndo com lanterna, eles sobem em um minuto."
  },
  {
   "id": "f8",
   "quem": "davi",
   "off": true,
   "texto": "Então eu faço o Ramos falar, pra ele tirar o olho da alavanca."
  },
  {
   "id": "f9",
   "quem": "davi",
   "tom": "desconfiado",
   "texto": "Por que deixaram a gente subir?"
  },
  {
   "id": "f10",
   "quem": "ramos",
   "tom": "calmo",
   "texto": "Porque daqui de cima não tem pra onde fugir."
  },
  {
   "id": "f11",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "E aí um raio cai no mar, tão perto que o vidro treme."
  },
  {
   "id": "f12",
   "quem": "davi",
   "off": true,
   "texto": "No clarão, quem corre por trás da lente é a Lia.",
   "semente": 102
  },
  {
   "id": "f13",
   "quem": "davi",
   "off": true,
   "texto": "O Ramos corre atrás da menina. E deixa a alavanca livre."
  },
  {
   "id": "f14",
   "quem": "lia",
   "tom": "grito",
   "texto": "Puxa AGORA!"
  },
  {
   "id": "f15",
   "quem": "davi",
   "off": true,
   "tom": "determinado",
   "texto": "Três passos. Dois. Um. E eu puxo com as duas mãos."
  },
  {
   "id": "f16",
   "quem": "davi",
   "off": true,
   "tom": "aliviado",
   "texto": "A lente acende. Três curtas, três longas, três curtas."
  },
  {
   "id": "f17",
   "quem": "davi",
   "off": true,
   "tom": "aliviado",
   "texto": "Um pedido de SOCORRO pro mar inteiro, no meio da tempestade."
  },
  {
   "id": "f18",
   "quem": "davi",
   "off": true,
   "tom": "aliviado",
   "texto": "Lá embaixo, até as botas param de subir."
  },
  {
   "id": "f19",
   "quem": "davi",
   "off": true,
   "tom": "aliviado",
   "texto": "E o Ramos só fica parado, com a luz piscando no rosto."
  },
  {
   "id": "f20",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Só que o raio sempre procura a coisa mais alta da ilha."
  },
  {
   "id": "f21",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "E a mais alta era a gente."
  }
 ],
