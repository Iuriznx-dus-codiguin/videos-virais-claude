{
 "serie": "voo-818",
 "parte": 17,
 "titulo": "A voz",
 "musica": "tensao",
 "falas": [
  {
   "id": "f1",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Se quem derrubou o seu avião vier buscar a prova, não corra com ela."
  },
  {
   "id": "f2",
   "quem": "davi",
   "off": true,
   "texto": "Porque quem segura a prova faz as regras."
  },
  {
   "id": "f3",
   "quem": "davi",
   "off": true,
   "texto": "Mas só se ninguém souber onde ela está."
  },
  {
   "id": "f4",
   "quem": "davi",
   "off": true,
   "texto": "Meu primeiro instinto é correr pra mata com a caixa preta."
  },
  {
   "id": "f5",
   "quem": "davi",
   "off": true,
   "tom": "determinado",
   "texto": "Não. Ela APITA. No escuro, isso me entrega."
  },
  {
   "id": "f6",
   "quem": "davi",
   "off": true,
   "texto": "Sobrevive a uma queda de avião, mas não sabe ficar quieta."
  },
  {
   "id": "f7",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "E o barco encosta na areia em menos de um minuto."
  },
  {
   "id": "f8",
   "quem": "davi",
   "off": true,
   "texto": "Então eu cavo do lado da cauda e enterro a caixa."
  },
  {
   "id": "f9",
   "quem": "davi",
   "off": true,
   "texto": "Areia molhada abafa o som. O apito some."
  },
  {
   "id": "f10",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Só que agora eu estou de mão vazia. E alguém desce do barco."
  },
  {
   "id": "f11",
   "quem": "davi",
   "off": true,
   "texto": "Não é o Capitão Ramos. É uma mulher de lenço."
  },
  {
   "id": "f12",
   "quem": "valeria",
   "tom": "calmo",
   "texto": "Davi Rocha... é você?"
  },
  {
   "id": "f13",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Eu conheço essa voz. É a voz do rádio."
  },
  {
   "id": "f14",
   "quem": "davi",
   "off": true,
   "texto": "A Valéria, diretora da companhia. A foto dela fica no meu hangar."
  },
  {
   "id": "f15",
   "quem": "valeria",
   "tom": "calmo",
   "texto": "Me dá a caixa, e todo mundo volta pra casa."
  },
  {
   "id": "f16",
   "quem": "davi",
   "tom": "determinado",
   "texto": "Tarde demais. A Marinha viu o pedido de SOCORRO."
  },
  {
   "id": "f17",
   "quem": "davi",
   "off": true,
   "texto": "Mentira. Eu não faço ideia se alguém viu."
  },
  {
   "id": "f18",
   "quem": "davi",
   "off": true,
   "texto": "Ela para, olha pro mar e fica quieta."
  },
  {
   "id": "f19",
   "quem": "davi",
   "off": true,
   "tom": "aliviado",
   "texto": "Por um segundo, eu acho que o blefe colou."
  },
  {
   "id": "f20",
   "quem": "davi",
   "off": true,
   "tom": "tenso",
   "texto": "Só que ela sorri. E chega mais perto."
  },
  {
   "id": "f21",
   "quem": "valeria",
   "tom": "calmo",
   "texto": "Então a Marinha vai querer um número."
  },
  {
   "id": "f22",
   "quem": "valeria",
   "tom": "calmo",
   "texto": "Quantos sobreviventes, Davi?"
  }
 ],
