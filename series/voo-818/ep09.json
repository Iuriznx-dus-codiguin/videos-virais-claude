{
  "serie": "voo-818",
  "parte": 9,
  "titulo": "O sinal",
  "musica": "tensao",
  "falas": [
    {
      "id": "f1",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Se alguém pedir socorro do outro lado da ilha, não corra pela areia."
    },
    {
      "id": "f2",
      "quem": "davi",
      "off": true,
      "texto": "Porque, na beira da água, a onda apaga cada passo."
    },
    {
      "id": "f3",
      "quem": "davi",
      "off": true,
      "texto": "Mas só se a pressa não falar mais alto."
    },
    {
      "id": "f4",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Depois do pedido de socorro, o farol pisca mais uma letra."
    },
    {
      "id": "f5",
      "quem": "otavio",
      "tom": "serio",
      "texto": "Ponto, traço, ponto, ponto. É um L."
    },
    {
      "id": "f6",
      "quem": "davi",
      "off": true,
      "tom": "determinado",
      "texto": "L de Lia. Ela está VIVA lá dentro."
    },
    {
      "id": "f7",
      "quem": "davi",
      "off": true,
      "texto": "E o Otávio já quer descer direto, pela areia seca."
    },
    {
      "id": "f8",
      "quem": "davi",
      "off": true,
      "tom": "serio",
      "texto": "Não. Pegada na areia seca fica até a maré voltar."
    },
    {
      "id": "f9",
      "quem": "otavio",
      "tom": "determinado",
      "texto": "Uma hora até o farol. O sol nasce em uma e meia."
    },
    {
      "id": "f10",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Aí, no meio da letra seguinte, a luz apaga.",
      "pausa_depois": 0.3
    },
    {
      "id": "f11",
      "quem": "otavio",
      "tom": "medo",
      "texto": "Alguém pegou ela no meio do pedido."
    },
    {
      "id": "f12",
      "quem": "cida",
      "tom": "serio",
      "texto": "Leva o rádio. Desligado. Se achar a menina, chama."
    },
    {
      "id": "f13",
      "quem": "davi",
      "off": true,
      "texto": "A Dona Cida fica com a jangada. Sobramos eu e um copiloto de tala."
    },
    {
      "id": "f14",
      "quem": "davi",
      "off": true,
      "texto": "Lá embaixo, a gente anda onde a onda bate."
    },
    {
      "id": "f15",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Só que, na beira da água, não tem onde se esconder."
    },
    {
      "id": "f16",
      "quem": "otavio",
      "tom": "sussurro",
      "texto": "Se aquele farol acender de novo, a gente aparece."
    },
    {
      "id": "f17",
      "quem": "davi",
      "off": true,
      "texto": "Então a gente corre curvado, colado nas pedras, sem luz."
    },
    {
      "id": "f18",
      "quem": "davi",
      "off": true,
      "texto": "Na ponta da praia, a gente para atrás de uma pedra."
    },
    {
      "id": "f19",
      "quem": "davi",
      "off": true,
      "tom": "aliviado",
      "texto": "Sem rastro, sem luz, sem barulho. Ninguém sabe onde a gente está.",
      "pausa_depois": 0.5
    },
    {
      "id": "f20",
      "quem": "davi",
      "off": true,
      "tom": "tenso",
      "texto": "Só que o rádio, desligado, acende sozinho na areia.",
      "pausa_depois": 0.4
    },
    {
      "id": "f21",
      "quem": "valeria",
      "off": true,
      "tom": "calmo",
      "texto": "Ótimo. Achei vocês.",
      "pausa_depois": 0.8
    }
  ],
