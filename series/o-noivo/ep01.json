{
  "serie": "o-noivo",
  "parte": 1,
  "titulo": "A mensagem",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "lara",
      "off": true,
      "texto": "Se o noivo da sua irmã tiver OUTRA esposa, não conte na véspera do casamento.",
      "tom": "tenso"
    },
    {
      "id": "f2",
      "quem": "lara",
      "off": true,
      "texto": "Eu sou a Lara, a madrinha. E a prova chegou no meu celular."
    },
    {
      "id": "f3",
      "quem": "lara",
      "off": true,
      "texto": "Mas prova só vale se ninguém APAGAR antes.",
      "tom": "serio"
    },
    {
      "id": "f4",
      "quem": "lara",
      "off": true,
      "texto": "Amanhã, às cinco, a Bia casa com o Ricardo. Na ilha do vovô."
    },
    {
      "id": "f5",
      "quem": "lara",
      "off": true,
      "texto": "Meu primeiro instinto é mostrar a foto pra ela."
    },
    {
      "id": "f6",
      "quem": "lara",
      "off": true,
      "texto": "Não. Na véspera, quem fala mal do noivo vira a VILÃ."
    },
    {
      "id": "f7",
      "quem": "lara",
      "off": true,
      "texto": "Faltam vinte e cinco horas pro sim. E aqui não pega sinal."
    },
    {
      "id": "f8",
      "quem": "lara",
      "off": true,
      "texto": "Então eu mostro pra minha mãe, a Dona Neide."
    },
    {
      "id": "f9",
      "quem": "neide",
      "texto": "Isso é montagem, Lara. Apaga isso.",
      "tom": "bravo"
    },
    {
      "id": "f10",
      "quem": "lara",
      "off": true,
      "texto": "Eu não apago. Subo no morro, onde pega sinal, e pergunto quem é."
    },
    {
      "id": "f11",
      "quem": "lara",
      "off": true,
      "texto": "A resposta: pergunta pra ele quem é a CAROL.",
      "tom": "tenso",
      "pausa_depois": 0.4
    },
    {
      "id": "f12",
      "quem": "lara",
      "off": true,
      "texto": "No jantar, na frente de todo mundo, eu pergunto."
    },
    {
      "id": "f13",
      "quem": "lara",
      "texto": "Ricardo... quem é a Carol?",
      "tom": "serio",
      "pausa_depois": 0.5
    },
    {
      "id": "f14",
      "quem": "lara",
      "off": true,
      "texto": "A garrafa escorrega da mão dele."
    },
    {
      "id": "f15",
      "quem": "ricardo",
      "texto": "Minha prima. Morreu faz cinco anos.",
      "tom": "triste"
    },
    {
      "id": "f16",
      "quem": "bia",
      "texto": "Satisfeita, Lara? Na véspera do meu casamento?",
      "tom": "bravo"
    },
    {
      "id": "f17",
      "quem": "lara",
      "off": true,
      "texto": "Então eu peço desculpa, abraço a Bia e apago a foto.",
      "tom": "aliviado"
    },
    {
      "id": "f18",
      "quem": "lara",
      "off": true,
      "texto": "Uma prima que morreu. Eu quase estraguei tudo.",
      "tom": "aliviado"
    },
    {
      "id": "f19",
      "quem": "lara",
      "off": true,
      "texto": "Só que, à meia-noite, o barco das flores encosta no cais.",
      "tom": "tenso"
    },
    {
      "id": "f20",
      "quem": "lara",
      "off": true,
      "texto": "Desce uma mulher de bandana vermelha, com um menino.",
      "pausa_depois": 0.4
    },
    {
      "id": "f21",
      "quem": "carol",
      "texto": "Oi. Eu sou a Carol.",
      "tom": "calmo",
      "pausa_depois": 0.6
    },
    {
      "id": "f22",
      "quem": "lara",
      "off": true,
      "texto": "A prima MORTA desceu do barco.",
      "tom": "tenso"
    }
  ],
