{
  "serie": "o-noivo",
  "parte": 4,
  "titulo": "A testemunha",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "lara",
      "off": true,
      "texto": "Se você pegar o noivo da sua irmã mentindo, não conte na frente dele.",
      "tom": "tenso"
    },
    {
      "id": "f2",
      "quem": "lara",
      "off": true,
      "texto": "Eu sou a Lara. Minha irmã casa às cinco, nesta ilha."
    },
    {
      "id": "f3",
      "quem": "lara",
      "off": true,
      "texto": "E o celular do noivo tá na MINHA mão."
    },
    {
      "id": "f4",
      "quem": "lara",
      "off": true,
      "texto": "Mas prova só vale se ele não tiver tempo de inventar.",
      "tom": "serio"
    },
    {
      "id": "f5",
      "quem": "lara",
      "off": true,
      "texto": "Meu primeiro instinto é correr e mostrar pra Bia ali mesmo."
    },
    {
      "id": "f6",
      "quem": "lara",
      "off": true,
      "texto": "Não. Do lado dele, a prova vira briga minha.",
      "tom": "serio"
    },
    {
      "id": "f7",
      "quem": "lara",
      "off": true,
      "texto": "Então eu espero a noiva ficar sozinha. Faltam sete horas."
    },
    {
      "id": "f8",
      "quem": "lara",
      "texto": "Bia, lê isso. Antes dele voltar.",
      "tom": "tenso"
    },
    {
      "id": "f9",
      "quem": "bia",
      "texto": "Assinatura da ilha? Que história é essa?",
      "tom": "nervoso"
    },
    {
      "id": "f10",
      "quem": "lara",
      "off": true,
      "texto": "Só que ele já sentiu falta do celular.",
      "tom": "tenso"
    },
    {
      "id": "f11",
      "quem": "ricardo",
      "texto": "Era surpresa, amor. Tô comprando a ilhota do lado.",
      "tom": "calmo"
    },
    {
      "id": "f12",
      "quem": "ricardo",
      "texto": "Pra uma pousada. Com o nome do seu avô.",
      "tom": "calmo"
    },
    {
      "id": "f13",
      "quem": "bia",
      "texto": "Viu, Lara? Chega de procurar defeito.",
      "tom": "bravo"
    },
    {
      "id": "f14",
      "quem": "lara",
      "off": true,
      "texto": "Pronto. Agora eu sou a CIUMENTA da família.",
      "tom": "triste"
    },
    {
      "id": "f15",
      "quem": "lara",
      "off": true,
      "texto": "Só que ninguém vende uma ilha sem papel assinado.",
      "tom": "serio"
    },
    {
      "id": "f16",
      "quem": "lara",
      "off": true,
      "texto": "E as malas dos noivos estão no depósito do vovô."
    },
    {
      "id": "f17",
      "quem": "lara",
      "off": true,
      "texto": "A do Ricardo tem senha. Três números.",
      "semente": 102
    },
    {
      "id": "f18",
      "quem": "lara",
      "off": true,
      "texto": "Eu tento a data do casamento. E ABRE.",
      "tom": "tenso"
    },
    {
      "id": "f19",
      "quem": "lara",
      "off": true,
      "texto": "Dentro, uma pasta: promessa de venda da Ilha do Farol."
    },
    {
      "id": "f20",
      "quem": "lara",
      "off": true,
      "texto": "Doze milhões, assinada por Ricardo Mendes, pra segunda às nove."
    },
    {
      "id": "f21",
      "quem": "lara",
      "off": true,
      "texto": "Papel, assinatura e preço. Isso nem ele explica.",
      "tom": "aliviado"
    },
    {
      "id": "f22",
      "quem": "lara",
      "off": true,
      "texto": "Só que embaixo tem mais uma assinatura. De testemunha.",
      "tom": "tenso",
      "pausa_depois": 0.4
    },
    {
      "id": "f23",
      "quem": "lara",
      "off": true,
      "texto": "A testemunha é a minha MÃE.",
      "tom": "tenso"
    }
  ],
