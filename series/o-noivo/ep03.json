{
  "serie": "o-noivo",
  "parte": 3,
  "titulo": "O preço da ilha",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "lara",
      "off": true,
      "texto": "Se o noivo da sua irmã pagar a dívida da sua mãe, não agradeça.",
      "tom": "tenso"
    },
    {
      "id": "f2",
      "quem": "lara",
      "off": true,
      "texto": "Eu sou a Lara. Hoje às cinco, minha irmã casa com o Ricardo."
    },
    {
      "id": "f3",
      "quem": "lara",
      "off": true,
      "texto": "E um favor desse tamanho sempre deixa RASTRO."
    },
    {
      "id": "f4",
      "quem": "lara",
      "off": true,
      "texto": "Mas só se eu achar o rastro antes do sim.",
      "tom": "serio"
    },
    {
      "id": "f5",
      "quem": "lara",
      "off": true,
      "texto": "Seis da manhã, a Carol vai embora. E a minha mãe confessa."
    },
    {
      "id": "f6",
      "quem": "neide",
      "texto": "A casa ia a leilão, filha. Ele pagou TUDO.",
      "tom": "triste"
    },
    {
      "id": "f7",
      "quem": "lara",
      "off": true,
      "texto": "Meu primeiro instinto é achar que ele é só generoso."
    },
    {
      "id": "f8",
      "quem": "lara",
      "off": true,
      "texto": "Não. Generoso não ameaça ninguém no cais de madrugada.",
      "tom": "serio"
    },
    {
      "id": "f9",
      "quem": "lara",
      "off": true,
      "texto": "Faltam onze horas pro sim. E aqui embaixo não pega sinal."
    },
    {
      "id": "f10",
      "quem": "lara",
      "off": true,
      "texto": "Então eu subo no morro e pesquiso o nome da ilha."
    },
    {
      "id": "f11",
      "quem": "lara",
      "off": true,
      "texto": "Um resort ofereceu doze milhões. E a minha irmã disse NÃO."
    },
    {
      "id": "f12",
      "quem": "lara",
      "off": true,
      "texto": "Porque o vovô pediu pra nunca vender o farol."
    },
    {
      "id": "f13",
      "quem": "lara",
      "off": true,
      "texto": "Só que hoje ela casa em comunhão total. Tudo vira dos dois.",
      "tom": "tenso"
    },
    {
      "id": "f14",
      "quem": "lara",
      "off": true,
      "texto": "Ou seja: ele pagou trezentos mil pra ganhar seis MILHÕES.",
      "tom": "tenso"
    },
    {
      "id": "f15",
      "quem": "lara",
      "off": true,
      "texto": "Então eu desço e fico de olho no Ricardo."
    },
    {
      "id": "f16",
      "quem": "ricardo",
      "texto": "Bom dia, cunhada. Dormiu BEM?",
      "tom": "calmo"
    },
    {
      "id": "f17",
      "quem": "lara",
      "off": true,
      "texto": "Eu tento falar com a Bia."
    },
    {
      "id": "f18",
      "quem": "bia",
      "texto": "Hoje não, Lara. Por favor.",
      "tom": "cansado"
    },
    {
      "id": "f19",
      "quem": "lara",
      "off": true,
      "texto": "Então os noivos descem pra beira do mar, de mãos dadas.",
      "tom": "aliviado"
    },
    {
      "id": "f20",
      "quem": "lara",
      "off": true,
      "texto": "Por um minuto, ele parece só um noivo apaixonado.",
      "tom": "aliviado"
    },
    {
      "id": "f21",
      "quem": "lara",
      "off": true,
      "texto": "Só que o celular dele ficou na areia. E acendeu.",
      "tom": "tenso",
      "pausa_depois": 0.4
    },
    {
      "id": "f22",
      "quem": "lara",
      "off": true,
      "texto": "Ele não quer a Bia. Quer a ILHA.",
      "tom": "tenso"
    }
  ],
