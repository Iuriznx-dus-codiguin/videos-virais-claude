{
  "serie": "o-noivo",
  "parte": 7,
  "titulo": "Sim ou não",
  "musica": "tensao",
  "falas": [
    {
      "id": "f1",
      "quem": "lara",
      "off": true,
      "texto": "Se você descobrir que o noivo é golpista na hora do sim, não grite.",
      "tom": "tenso"
    },
    {
      "id": "f2",
      "quem": "lara",
      "off": true,
      "texto": "Porque todo golpista assina alguma coisa. E assinatura é PROVA."
    },
    {
      "id": "f3",
      "quem": "lara",
      "off": true,
      "texto": "Mas só se ninguém estragar tudo antes da hora.",
      "tom": "serio"
    },
    {
      "id": "f4",
      "quem": "lara",
      "off": true,
      "texto": "Eu sou a Lara. Cinco da tarde: minha irmã casa com um golpista."
    },
    {
      "id": "f5",
      "quem": "sandra",
      "texto": "Se alguém é contra este casamento, fale agora.",
      "tom": "serio"
    },
    {
      "id": "f6",
      "quem": "lara",
      "off": true,
      "texto": "Meu primeiro instinto é abrir a boca e contar TUDO."
    },
    {
      "id": "f7",
      "quem": "lara",
      "off": true,
      "texto": "Mas minha irmã, a noiva, segura a minha mão."
    },
    {
      "id": "f8",
      "quem": "bia",
      "texto": "Calma, Lara. Ainda não.",
      "tom": "serio"
    },
    {
      "id": "f9",
      "quem": "lara",
      "off": true,
      "texto": "Assinou o casamento, ele vende a ilha. Doze milhões, ali na areia.",
      "tom": "tenso"
    },
    {
      "id": "f10",
      "quem": "lara",
      "off": true,
      "texto": "E ele assina o livro: Ricardo Mendes."
    },
    {
      "id": "f11",
      "quem": "bia",
      "texto": "Agora eu sou CONTRA. O nome dele é Rodrigo Paiva.",
      "tom": "bravo"
    },
    {
      "id": "f12",
      "quem": "lara",
      "off": true,
      "texto": "E a juíza? A Dra. Sandra é DELEGADA."
    },
    {
      "id": "f13",
      "quem": "bia",
      "texto": "Eu chamei a polícia pelo rádio do farol. De madrugada.",
      "tom": "serio"
    },
    {
      "id": "f14",
      "quem": "lara",
      "off": true,
      "texto": "E do barco das flores desce a Carol, com o filho dele."
    },
    {
      "id": "f15",
      "quem": "sandra",
      "texto": "Nome falso no livro é crime, Rodrigo. Flagrante.",
      "tom": "serio"
    },
    {
      "id": "f16",
      "quem": "lara",
      "off": true,
      "texto": "Só que ele larga a caneta e corre pro cais.",
      "tom": "tenso"
    },
    {
      "id": "f17",
      "quem": "lara",
      "off": true,
      "texto": "Se ele chegar no barco, some de novo.",
      "tom": "tenso"
    },
    {
      "id": "f18",
      "quem": "ricardo",
      "texto": "Fica com a ilha, Bia. Eu fico com o barco.",
      "tom": "calmo"
    },
    {
      "id": "f19",
      "quem": "neide",
      "texto": "Procurando a chave, RODRIGO?",
      "tom": "serio"
    },
    {
      "id": "f20",
      "quem": "lara",
      "off": true,
      "texto": "Minha mãe. A testemunha que ele comprou."
    },
    {
      "id": "f21",
      "quem": "lara",
      "off": true,
      "texto": "Ele saiu algemado, a venda caiu, e a ilha continua da família.",
      "tom": "aliviado"
    },
    {
      "id": "f22",
      "quem": "lara",
      "off": true,
      "texto": "Minha irmã jogou o buquê no mar. Pro VOVÔ.",
      "tom": "aliviado"
    }
  ],
