{
  "serie": "o-noivo",
  "parte": 5,
  "titulo": "A adega",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "lara",
      "off": true,
      "texto": "Se a sua mãe assinar um contrato contra a sua irmã, não grite com ela.",
      "tom": "tenso"
    },
    {
      "id": "f2",
      "quem": "lara",
      "off": true,
      "texto": "Porque mãe que erra por amor ainda pode mudar de LADO."
    },
    {
      "id": "f3",
      "quem": "lara",
      "off": true,
      "texto": "Mas só se ela souber a verdade inteira.",
      "tom": "serio"
    },
    {
      "id": "f4",
      "quem": "lara",
      "off": true,
      "texto": "Eu sou a Lara. Minha irmã casa às cinco, com um mentiroso."
    },
    {
      "id": "f5",
      "quem": "lara",
      "off": true,
      "texto": "E a minha mãe assinou a venda da ilha como testemunha."
    },
    {
      "id": "f6",
      "quem": "lara",
      "off": true,
      "texto": "Meu primeiro instinto é jogar o contrato na cara dela."
    },
    {
      "id": "f7",
      "quem": "lara",
      "off": true,
      "texto": "Não. Se eu brigar, ela defende ele de novo.",
      "tom": "serio"
    },
    {
      "id": "f8",
      "quem": "lara",
      "texto": "Mãe. Por que você assinou isso?",
      "tom": "tenso"
    },
    {
      "id": "f9",
      "quem": "neide",
      "texto": "Ele pagou a casa, filha. Eu ia pra RUA.",
      "tom": "triste"
    },
    {
      "id": "f10",
      "quem": "neide",
      "texto": "E com doze milhões, ninguém mais ia passar aperto.",
      "tom": "triste"
    },
    {
      "id": "f11",
      "quem": "lara",
      "off": true,
      "texto": "Faltam seis horas. Então eu mostro a certidão que a Carol me deu."
    },
    {
      "id": "f12",
      "quem": "lara",
      "off": true,
      "texto": "Pai: Rodrigo Paiva. O mesmo noivo, com outro NOME.",
      "tom": "tenso"
    },
    {
      "id": "f13",
      "quem": "neide",
      "texto": "Ele tem um filho? E abandonou?",
      "tom": "nervoso"
    },
    {
      "id": "f14",
      "quem": "lara",
      "off": true,
      "texto": "E em dez segundos, a minha mãe muda de lado."
    },
    {
      "id": "f15",
      "quem": "lara",
      "off": true,
      "texto": "Só que quem precisa ouvir isso é a Bia.",
      "tom": "serio"
    },
    {
      "id": "f16",
      "quem": "lara",
      "off": true,
      "texto": "Então a gente desce pra praia e conta absolutamente tudo."
    },
    {
      "id": "f17",
      "quem": "neide",
      "texto": "Filha, eu errei. Ele não é quem diz.",
      "tom": "triste"
    },
    {
      "id": "f18",
      "quem": "lara",
      "off": true,
      "texto": "Minha irmã não fala nada. Só escuta."
    },
    {
      "id": "f19",
      "quem": "lara",
      "off": true,
      "texto": "Então ela pega a certidão, dobra devagar e guarda no bolso."
    },
    {
      "id": "f20",
      "quem": "lara",
      "off": true,
      "texto": "Pronto. Agora ela cancela tudo e o Ricardo vai embora.",
      "tom": "aliviado"
    },
    {
      "id": "f21",
      "quem": "lara",
      "off": true,
      "texto": "Só que ela enxuga o rosto e olha pra mim.",
      "tom": "tenso",
      "pausa_depois": 0.4
    },
    {
      "id": "f22",
      "quem": "bia",
      "texto": "O casamento CONTINUA.",
      "tom": "serio"
    }
  ],
