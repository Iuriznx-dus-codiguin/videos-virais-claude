 "falas": [
  {
   "id": "f1",
   "quem": "tito",
   "texto": "Sua torradeira não tem olhos. Então como ela SABE a hora de pular o pão?",
   "tom": "animado"
  },
  {
   "id": "f2",
   "quem": "tito",
   "texto": "Em 1919, o mecânico Charles Strite cansou de comer torrada QUEIMADA no refeitório da fábrica.",
   "off": true
  },
  {
   "id": "f3",
   "quem": "tito",
   "texto": "Naquele tempo, alguém tinha que ficar de olho e tirar o pão na hora certa.",
   "off": true
  },
  {
   "id": "f4",
   "quem": "tito",
   "texto": "Então ele juntou um RELÓGIO e uma mola: deu o tempo, a mola empurra o pão para cima!",
   "off": true,
   "tom": "animado",
   "pausa_depois": 0.3
  },
  {
   "id": "f5",
   "quem": "tito",
   "texto": "Hoje, em muita torradeira, quem decide a hora é OUTRA peça, escondida lá dentro."
  },
  {
   "id": "f6",
   "quem": "tito",
   "texto": "Você abaixa a alavanca, o pão desce, e uma TRAVA segura tudo lá embaixo."
  },
  {
   "id": "f7",
   "quem": "tito",
   "texto": "Ao mesmo tempo, a eletricidade chega nos FIOS, e eles ficam vermelhos de quente."
  },
  {
   "id": "f8",
   "quem": "tito",
   "texto": "MAS um fio comum, nesse calor, enferruja e arrebenta rapidinho.",
   "tom": "tenso",
   "pausa_depois": 0.35
  },
  {
   "id": "f9",
   "quem": "tito",
   "texto": "Por isso o fio é de NÍQUEL com cromo, que aguenta ficar vermelho sem estragar.",
   "pausa_depois": 0.3
  },
  {
   "id": "f10",
   "quem": "tito",
   "texto": "E quem decide a hora? Uma lâmina de DOIS metais grudados, bem perto do calor.",
   "pausa_depois": 0.2
  },
  {
   "id": "f11",
   "quem": "tito",
   "texto": "Com o calor, um metal estica mais que o outro, e a lâmina ENTORTA."
  },
  {
   "id": "f12",
   "quem": "tito",
   "texto": "Entortou o bastante, ela empurra a trava, e a MOLA joga o pão para cima!",
   "tom": "animado",
   "pausa_depois": 0.3
  },
  {
   "id": "f13",
   "quem": "tito",
   "texto": "E o botão de mais ou menos torrado só muda o quanto a lâmina precisa entortar."
  },
  {
   "id": "f14",
   "quem": "tito",
   "texto": "Esse esticar com o calor tem nome: DILATAÇÃO.",
   "pausa_depois": 0.3
  },
  {
   "id": "f15",
   "quem": "tito",
   "texto": "E o mais curioso: a torradeira que pula o pão chegou nas casas ANTES do pão vendido já fatiado.",
   "tom": "animado"
  },
  {
   "id": "f16",
   "quem": "tito",
   "texto": "Ou seja: essa torradeira não sabe a HORA. Ela sente o calor, e um pedacinho de metal entorta.",
   "tom": "animado"
  }
 ],
 "chamada": {
  "pergunta": "E agora, topa construir uma fechadura?",
  "texto": "Comenta",
  "destaque": "FECHA­DURA"
 },
