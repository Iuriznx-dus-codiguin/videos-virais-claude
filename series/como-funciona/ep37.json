 "falas": [
  {
   "id": "f1",
   "quem": "tito",
   "texto": "Concreto não é tão forte quanto parece: uma viga só de concreto QUEBRA assim.",
   "tom": "surpreso"
  },
  {
   "id": "f2",
   "quem": "tito",
   "texto": "Em 1867, em Paris, um JARDINEIRO fazia vasos de planta de concreto.",
   "off": true
  },
  {
   "id": "f3",
   "quem": "tito",
   "texto": "MAS os vasos grandes viviam RACHANDO, e quebravam na hora de carregar.",
   "off": true,
   "tom": "tenso"
  },
  {
   "id": "f4",
   "quem": "tito",
   "texto": "Então ele enfiou uma rede de FERRO dentro do concreto. E o vaso parou de rachar.",
   "off": true,
   "pausa_depois": 0.2
  },
  {
   "id": "f5",
   "quem": "tito",
   "texto": "Olha a viga por dentro. Com peso em cima, a parte de cima fica APERTADA, e o concreto aguenta bem."
  },
  {
   "id": "f6",
   "quem": "tito",
   "texto": "MAS a parte de baixo fica ESTICADA, e esticando, o concreto aguenta umas dez vezes menos.",
   "tom": "tenso"
  },
  {
   "id": "f7",
   "quem": "tito",
   "texto": "Por isso, a rede virou barras de AÇO, bem embaixo, onde a viga estica.",
   "pausa_depois": 0.2
  },
  {
   "id": "f8",
   "quem": "tito",
   "texto": "O concreto segura o aperto, e o aço segura o puxão. Juntos, viram concreto ARMADO.",
   "pausa_depois": 0.2
  },
  {
   "id": "f9",
   "quem": "tito",
   "texto": "É por isso que toda obra tem aquela FERRAGEM pronta antes de o concreto chegar."
  },
  {
   "id": "f10",
   "quem": "tito",
   "texto": "MAS os engenheiros diziam: no sol, o ferro estica e racha o concreto por DENTRO.",
   "tom": "tenso"
  },
  {
   "id": "f11",
   "quem": "tito",
   "texto": "E não racha! Aço e concreto esticam quase IGUAL com o calor, e o jardineiro passou anos provando isso.",
   "tom": "feliz",
   "pausa_depois": 0.2
  },
  {
   "id": "f12",
   "quem": "tito",
   "texto": "MAS se a água chega no aço, ele enferruja, INCHA, e estoura o concreto.",
   "tom": "tenso"
  },
  {
   "id": "f13",
   "quem": "tito",
   "texto": "Por isso as barras ficam escondidas lá dentro, com uns dedos de concreto em VOLTA.",
   "pausa_depois": 0.3
  },
  {
   "id": "f14",
   "quem": "tito",
   "texto": "Hoje ele segura prédios e pontes no mundo inteiro, e até o Cristo Redentor é de concreto ARMADO.",
   "tom": "surpreso",
   "pausa_depois": 0.2
  },
  {
   "id": "f15",
   "quem": "tito",
   "texto": "E tudo isso começou num vaso de PLANTA.",
   "tom": "feliz"
  }
 ],
 "chamada": {
  "pergunta": "E agora, topa construir um guindaste?",
  "texto": "Comenta",
  "destaque": "GUINDASTE"
 },
 "postagem": {
  "titulo": "Como funciona o concreto armado? Um jardineiro inventou",
  "descricao": "Como funciona o concreto armado por dentro: o concreto aguenta o aperto, as barras de aço (a ferragem) aguentam o puxão. E a história do jardineiro Joseph Monier, que inventou tudo com um vaso de planta em 1867.",
  "hashtags": [
   "comofunciona",
   "concreto",
   "engenharia",
   "construcao",
   "curiosidades"
  ],
  "comentario": "Eu achava que concreto era forte sozinho. Sem o aço, uma viga quebra fácil! Você sabia?",
  "capa": "f1:quebra+0.4"
 },
