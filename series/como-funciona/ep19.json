 "falas": [
  {
   "id": "f1",
   "quem": "tito",
   "texto": "Esse terceiro furinho da tomada... para que ele serve?",
   "tom": "animado"
  },
  {
   "id": "f2",
   "quem": "tito",
   "texto": "Lá por 1900, para ligar um ferro de passar, você tirava a LÂMPADA do teto.",
   "off": true
  },
  {
   "id": "f3",
   "quem": "tito",
   "texto": "E rosqueava o fio do ferro no lugar dela. O fio torcia, e às vezes saía FAÍSCA.",
   "off": true
  },
  {
   "id": "f4",
   "quem": "tito",
   "texto": "Em 1904, o americano Harvey Hubbell patenteou um plugue que encaixa e sai só PUXANDO.",
   "off": true
  },
  {
   "id": "f5",
   "quem": "tito",
   "texto": "MAS o plugue dele tinha só DOIS pinos. Então por que a tomada de hoje tem TRÊS?",
   "off": true,
   "tom": "tenso",
   "pausa_depois": 0.3
  },
  {
   "id": "f6",
   "quem": "tito",
   "texto": "Os dois primeiros são fáceis: a eletricidade precisa de ida e VOLTA."
  },
  {
   "id": "f7",
   "quem": "tito",
   "texto": "Ela chega por um fio, acende a lâmpada e volta pelo outro. É um CIRCUITO, uma volta completa."
  },
  {
   "id": "f8",
   "quem": "tito",
   "texto": "E o INTERRUPTOR? Ele só afasta uma lamininha e abre um buraco nesse caminho."
  },
  {
   "id": "f9",
   "quem": "tito",
   "texto": "Sem caminho completo, a eletricidade para, e a luz APAGA.",
   "pausa_depois": 0.3
  },
  {
   "id": "f10",
   "quem": "tito",
   "texto": "MAS imagina que, dentro da geladeira, um fio se solta e encosta na LATARIA.",
   "tom": "tenso"
  },
  {
   "id": "f11",
   "quem": "tito",
   "texto": "A geladeira inteira fica com eletricidade, e por fora ela parece NORMAL.",
   "tom": "tenso"
  },
  {
   "id": "f12",
   "quem": "tito",
   "texto": "Quem encostar nela vira o caminho até o chão: CHOQUE!",
   "tom": "tenso",
   "pausa_depois": 0.3
  },
  {
   "id": "f13",
   "quem": "tito",
   "texto": "Por isso existe o terceiro furinho: o TERRA.",
   "tom": "animado"
  },
  {
   "id": "f14",
   "quem": "tito",
   "texto": "Ele liga a lataria a uma barra de metal enterrada no CHÃO."
  },
  {
   "id": "f15",
   "quem": "tito",
   "texto": "Se um fio se soltar, a eletricidade foge por ali, um caminho muito mais FÁCIL que o seu corpo."
  },
  {
   "id": "f16",
   "quem": "tito",
   "texto": "Isso se chama ATERRAMENTO: um caminho seguro até a terra.",
   "pausa_depois": 0.3
  },
  {
   "id": "f17",
   "quem": "tito",
   "texto": "E repara: o terceiro furinho não serve para ligar NADA."
  },
  {
   "id": "f18",
   "quem": "tito",
   "texto": "Ele só trabalha no dia em que salva você.",
   "tom": "animado"
  }
 ],
