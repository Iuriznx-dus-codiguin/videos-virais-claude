 "falas": [
  {
   "id": "f1",
   "quem": "tito",
   "texto": "Uma torre fina e um braço comprido. Dá para levantar TONELADAS lá no alto?",
   "tom": "surpreso"
  },
  {
   "id": "f2",
   "quem": "tito",
   "texto": "Se você pendurar o peso na ponta do braço e puxar a corda, ele SOBE."
  },
  {
   "id": "f3",
   "quem": "tito",
   "texto": "MAS o peso puxa a ponta para baixo, e a torre inteira TOMBA.",
   "tom": "tenso"
  },
  {
   "id": "f4",
   "quem": "tito",
   "texto": "Então, você põe do outro lado um braço curto, com blocos de concreto: o CONTRAPESO.",
   "pausa_depois": 0.2
  },
  {
   "id": "f5",
   "quem": "tito",
   "texto": "Funciona como uma GANGORRA: o peso de um lado segura o peso do outro."
  },
  {
   "id": "f6",
   "quem": "tito",
   "texto": "SÓ QUE sem nada no gancho, é o contrapeso que puxa a torre para TRÁS."
  },
  {
   "id": "f7",
   "quem": "tito",
   "texto": "Então, você prende o pé da torre num bloco GIGANTE de concreto, enterrado no chão.",
   "pausa_depois": 0.2
  },
  {
   "id": "f8",
   "quem": "tito",
   "texto": "MAS assim o peso só sobe e desce, sempre no mesmo LUGAR."
  },
  {
   "id": "f9",
   "quem": "tito",
   "texto": "Então, a parte de cima GIRA, e um carrinho corre pelo braço, levando o gancho para perto ou para longe.",
   "pausa_depois": 0.2
  },
  {
   "id": "f10",
   "quem": "tito",
   "texto": "SÓ QUE lá na ponta, o mesmo peso puxa muito mais, como uma mochila no braço ESTICADO.",
   "tom": "tenso"
  },
  {
   "id": "f11",
   "quem": "tito",
   "texto": "Então, você põe uma TRAVA que mede o puxão: na ponta, o guindaste levanta bem menos peso.",
   "pausa_depois": 0.2
  },
  {
   "id": "f12",
   "quem": "tito",
   "texto": "MAS o prédio cresce, andar por andar, e a torre fica BAIXA demais."
  },
  {
   "id": "f13",
   "quem": "tito",
   "texto": "Então, ele levanta um pedaço de torre, um macaco ergue a parte de cima, e o pedaço novo ENCAIXA embaixo.",
   "pausa_depois": 0.2
  },
  {
   "id": "f14",
   "quem": "tito",
   "texto": "E de noite, o freio do giro fica solto: o braço vira com o vento, igual uma BIRUTA.",
   "tom": "surpreso",
   "pausa_depois": 0.3
  },
  {
   "id": "f15",
   "quem": "tito",
   "texto": "Parabéns! Você construiu um guindaste de torre: toneladas lá no ALTO, sem tombar.",
   "tom": "feliz"
  }
 ],
 "chamada": {
  "pergunta": "E agora, topa construir um arranha-céu?",
  "texto": "Comenta",
  "destaque": "PRÉDIO"
 },
 "postagem": {
  "titulo": "Como funciona o guindaste de torre? Por que não tomba",
  "descricao": "Como funciona o guindaste de torre (guindaste de obra): contrapeso, fundação de concreto, giro, carrinho na lança e a trava de carga. E como ele cresce sozinho, encaixando pedaços de torre.",
  "hashtags": [
