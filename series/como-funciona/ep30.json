 "falas": [
  {
   "id": "f1",
   "quem": "tito",
   "texto": "Uma tábua e um motor. Dá para fazer isso VOAR?",
   "tom": "surpreso"
  },
  {
   "id": "f2",
   "quem": "tito",
   "texto": "Se você prender um motor com hélice numa tábua, ela corre a pista inteira... e não sai do CHÃO."
  },
  {
   "id": "f3",
   "quem": "tito",
   "texto": "MAS a tábua reta só corta o ar. Para subir, ela tem que empurrar o ar para BAIXO."
  },
  {
   "id": "f4",
   "quem": "tito",
   "texto": "Então, você inclina a tábua de nariz para CIMA. Ela joga o ar para baixo, e o ar empurra a tábua para cima: ela decola!",
   "pausa_depois": 0.2
  },
  {
   "id": "f5",
   "quem": "tito",
   "texto": "SÓ QUE a tábua inclinada freia muito. E se você inclinar demais, o ar descola de cima dela, e ela DESPENCA.",
   "tom": "tenso"
  },
  {
   "id": "f6",
   "quem": "tito",
   "texto": "Então, você troca a tábua por uma ASA, grossa na frente e curvada em cima. O ar acompanha a curva e desce, com bem menos freio.",
   "pausa_depois": 0.2
  },
  {
   "id": "f7",
   "quem": "tito",
   "texto": "MAS, no primeiro vento, o avião começa a dar CAMBALHOTA, que nem uma folha caindo.",
   "tom": "tenso"
  },
  {
   "id": "f8",
   "quem": "tito",
   "texto": "Então, você coloca uma CAUDA: uma asinha deitada e uma barbatana em pé, que deixam o nariz para a frente, como as penas de uma flecha."
  },
  {
   "id": "f9",
   "quem": "tito",
   "texto": "SÓ QUE agora ele só voa reto. E para SUBIR, descer e fazer curva?"
  },
  {
   "id": "f10",
   "quem": "tito",
   "texto": "Então, você coloca abas que se mexem, os LEMES: na cauda, levantam e abaixam o nariz; nas pontas das asas, inclinam o avião para virar.",
   "pausa_depois": 0.2
  },
  {
   "id": "f11",
   "quem": "tito",
   "texto": "MAS para pousar, ele tem que voar devagar, e asa devagar segura MENOS.",
   "tom": "tenso"
  },
  {
   "id": "f12",
   "quem": "tito",
   "texto": "Então, você coloca FLAPS: pedaços que saem de trás da asa e deixam ela maior e mais curvada, para segurar o avião devagarinho.",
   "pausa_depois": 0.3
  },
  {
   "id": "f13",
   "quem": "tito",
   "texto": "E SE o motor parar lá no alto? O motor só empurra para a frente. Quem segura é a ASA, e o avião desce planando.",
   "pausa_depois": 0.3
  },
  {
   "id": "f14",
   "quem": "tito",
   "texto": "Parabéns! Você construiu um AVIÃO!",
   "tom": "feliz"
  }
 ],
 "chamada": {
  "pergunta": "E agora, topa construir uma usina hidrelétrica?",
