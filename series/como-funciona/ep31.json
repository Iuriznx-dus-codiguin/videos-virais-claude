 "falas": [
  {
   "id": "f1",
   "quem": "tito",
   "texto": "Um rio, uma roda e um ímã. Dá para acender uma cidade INTEIRA?",
   "tom": "surpreso"
  },
  {
   "id": "f2",
   "quem": "tito",
   "texto": "Se você puser uma roda d'água no rio, a correnteza empurra as pás, e a roda GIRA sozinha."
  },
  {
   "id": "f3",
   "quem": "tito",
   "texto": "MAS uma roda girando não acende lâmpada NENHUMA."
  },
  {
   "id": "f4",
   "quem": "tito",
   "texto": "Então, você prende um ÍMÃ na roda, girando dentro de um rolo de fio de cobre. Ímã girando perto do fio empurra a eletricidade.",
   "pausa_depois": 0.2
  },
  {
   "id": "f5",
   "quem": "tito",
   "texto": "SÓ QUE o rio corre devagar, a roda gira fraquinha, e a lâmpada só PISCA."
  },
  {
   "id": "f6",
   "quem": "tito",
   "texto": "Então, você constrói uma BARRAGEM, uma parede no rio, e a água vai se juntando atrás dela até virar um lago lá no alto.",
   "pausa_depois": 0.2
  },
  {
   "id": "f7",
   "quem": "tito",
   "texto": "MAS água parada não gira NADA."
  },
  {
   "id": "f8",
   "quem": "tito",
   "texto": "Então, você abre um TUBO lá no fundo do lago. A água desce por ele com o peso do lago inteiro em cima, e sai com muita força.",
   "pausa_depois": 0.2
  },
  {
   "id": "f9",
   "quem": "tito",
   "texto": "SÓ QUE, com tanta força, a roda aberta espirra água para todo lado e QUEBRA.",
   "tom": "tenso"
  },
  {
   "id": "f10",
   "quem": "tito",
   "texto": "Então, você troca a roda por uma TURBINA: pás curvas de aço, dentro de uma caixa fechada, que aproveitam quase toda a força da água.",
   "pausa_depois": 0.2
  },
  {
   "id": "f11",
   "quem": "tito",
   "texto": "MAS a cidade fica longe, e eletricidade viajando muito longe se perde no caminho, só esquentando o FIO."
  },
  {
   "id": "f12",
   "quem": "tito",
   "texto": "Então, você coloca um TRANSFORMADOR, que aumenta a voltagem, e manda a eletricidade pelas torres até as casas.",
   "pausa_depois": 0.3
  },
  {
   "id": "f13",
   "quem": "tito",
   "texto": "E repara: no Brasil, de cada dez lâmpadas acesas, umas SEIS acendem com água caindo.",
   "pausa_depois": 0.3
  },
  {
   "id": "f14",
   "quem": "tito",
   "texto": "Parabéns! Você construiu uma USINA hidrelétrica!",
   "tom": "feliz"
  }
 ],
 "chamada": {
  "pergunta": "E o painel solar? Como a luz vira eletricidade?",
  "texto": "Comenta",
  "destaque": "SOLAR"
 },
 "postagem": {
  "titulo": "Como funciona a usina hidrelétrica? Do rio até a tomada",
  "descricao": "Como funciona a usina hidrelétrica por dentro: a barragem que junta a água num lago, o tubo que leva a água com força até a turbina, o gerador com ímã e fio de cobre, o transformador e as torres de alta tensão até a sua casa. No Brasil, cerca de 6 em cada 10 lâmpadas acendem com água caindo.",
