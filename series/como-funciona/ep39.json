 "falas": [
  {
   "id": "f1",
   "quem": "tito",
   "texto": "Um terreninho e mil pessoas para morar. Dá para empilhar CEM andares?",
   "tom": "surpreso"
  },
  {
   "id": "f2",
   "quem": "tito",
   "texto": "Se você empilhar tijolo sobre tijolo, as paredes seguram cada andar, igual numa casa."
  },
  {
   "id": "f3",
   "quem": "tito",
   "texto": "MAS cada andar pesa sobre o de baixo, e a parede lá embaixo RACHA.",
   "tom": "tenso"
  },
  {
   "id": "f4",
   "quem": "tito",
   "texto": "Para aguentar, a parede tem que ser GROSSA: quase dois metros, com só dezesseis andares."
  },
  {
   "id": "f5",
   "quem": "tito",
   "texto": "Então, você troca a parede por um ESQUELETO de aço: colunas e vigas seguram todo o peso.",
   "pausa_depois": 0.2
  },
  {
   "id": "f6",
   "quem": "tito",
   "texto": "E por fora, só uma pele de VIDRO, pendurada no esqueleto."
  },
  {
   "id": "f7",
   "quem": "tito",
   "texto": "SÓ QUE o prédio fica tão pesado, que o chão AFUNDA embaixo dele.",
   "tom": "tenso"
  },
  {
   "id": "f8",
   "quem": "tito",
   "texto": "Então, você crava ESTACAS, colunas de concreto enterradas até a rocha firme.",
   "pausa_depois": 0.2
  },
  {
   "id": "f9",
   "quem": "tito",
   "texto": "MAS lá no alto, o VENTO empurra o prédio de lado, como a vela de um barco."
  },
  {
   "id": "f10",
   "quem": "tito",
   "texto": "Então, você ergue no meio um NÚCLEO de concreto, a coluna oca onde passam elevador e escada.",
   "pausa_depois": 0.2
  },
  {
   "id": "f11",
   "quem": "tito",
   "texto": "SÓ QUE mesmo assim, lá em cima ele BALANÇA, e quem está dentro fica enjoado.",
   "tom": "tenso"
  },
  {
   "id": "f12",
   "quem": "tito",
   "texto": "Então, você pendura lá no topo uma BOLA de aço gigante, que balança para o lado contrário.",
   "pausa_depois": 0.2
  },
  {
   "id": "f13",
   "quem": "tito",
   "texto": "Num prédio de verdade, essa bola pesa seiscentas e sessenta toneladas: mais que CEM elefantes.",
   "tom": "surpreso"
  },
  {
   "id": "f14",
   "quem": "tito",
   "texto": "E num tufão, essa bola já balançou um METRO inteiro, para o prédio balançar menos.",
   "tom": "surpreso",
   "pausa_depois": 0.3
  },
  {
   "id": "f15",
   "quem": "tito",
   "texto": "Parabéns! Você construiu um arranha-céu: cem andares num terreninho.",
   "tom": "feliz"
  }
 ],
 "chamada": {
  "pergunta": "E o raio? Ele nunca cai duas vezes no mesmo lugar?",
  "texto": "Comenta",
  "destaque": "PARA-RAIOS"
 },
