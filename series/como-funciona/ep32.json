 "falas": [
  {
   "id": "f1",
   "quem": "tito",
   "texto": "Esse painel não tem NENHUMA peça que se mexe. Então como ele gira esse ventilador?",
   "tom": "surpreso"
  },
  {
   "id": "f2",
   "quem": "tito",
   "texto": "Em 1839, em Paris, um rapaz de 19 anos mergulhou duas placas de metal num LÍQUIDO.",
   "off": true
  },
  {
   "id": "f3",
   "quem": "tito",
   "texto": "Quando a luz do sol batia numa delas, o ponteiro do medidor MEXIA. A luz estava fazendo corrente!",
   "off": true
  },
  {
   "id": "f4",
   "quem": "tito",
   "texto": "MAS era uma corrente tão fraquinha que não acendia NADA.",
   "off": true,
   "tom": "tenso",
   "pausa_depois": 0.2
  },
  {
   "id": "f5",
   "quem": "tito",
   "texto": "Hoje, o painel é feito de SILÍCIO, um material que vem da areia."
  },
  {
   "id": "f6",
   "quem": "tito",
   "texto": "Cada pacotinho de luz que bate no silício solta um ELÉTRON, uma bolinha de eletricidade."
  },
  {
   "id": "f7",
   "quem": "tito",
   "texto": "MAS o elétron solto volta para o lugar dele num piscar de olhos, e não sobra corrente NENHUMA.",
   "tom": "tenso",
   "pausa_depois": 0.2
  },
  {
   "id": "f8",
   "quem": "tito",
   "texto": "Por isso a placa tem DUAS camadas: uma com elétron sobrando, e outra com elétron faltando."
  },
  {
   "id": "f9",
   "quem": "tito",
   "texto": "Na divisa entre elas nasce uma LADEIRA invisível, que empurra o elétron solto para cima e não deixa ele voltar."
  },
  {
   "id": "f10",
   "quem": "tito",
   "texto": "Lá em cima, fios de PRATA bem fininhos recolhem os elétrons, que dão a volta pelo fio e acendem a lâmpada.",
   "pausa_depois": 0.2
  },
  {
   "id": "f11",
   "quem": "tito",
   "texto": "SÓ QUE o silício brilha que nem espelho, e devolve um monte de luz para o CÉU."
  },
  {
   "id": "f12",
   "quem": "tito",
   "texto": "Então ele ganha uma película que segura a luz. É ela que deixa o painel AZUL escuro.",
   "pausa_depois": 0.2
  },
  {
   "id": "f13",
   "quem": "tito",
   "texto": "Isso se chama efeito FOTOVOLTAICO: luz que vira voltagem, a força da eletricidade.",
   "pausa_depois": 0.3
  },
  {
   "id": "f14",
   "quem": "tito",
   "texto": "E repara: em 1958, um satélite com painel solar foi para o espaço. E está lá em cima até HOJE.",
   "pausa_depois": 0.3
  },
  {
   "id": "f15",
   "quem": "tito",
   "texto": "Nenhuma peça se mexe no painel. Quem anda são só os ELÉTRONS.",
   "tom": "feliz"
  }
 ],
 "chamada": {
  "pergunta": "E o celular? Como a sua voz chega do outro lado?",
  "texto": "Comenta",
  "destaque": "CELULAR"
 },
 "postagem": {
  "titulo": "Como funciona o painel solar? Nada se mexe lá dentro",
  "descricao": "Como funciona o painel solar por dentro: a luz solta elétrons no silício, as duas camadas empurram a eletricidade para um lado só, os fios de prata recolhem a corrente e a película antirreflexo deixa o painel azul. E o rapaz de 19 anos que descobriu o efeito fotovoltaico em 1839.",
  "hashtags": [
   "comofunciona",
   "painelsolar",
   "energiasolar",
   "fisica",
   "curiosidades"
  ],
  "comentario": "Eu achava que o painel era azul só de enfeite. Você sabia que é a película que segura a luz?",
  "capa": "f1:mexe"
 },
