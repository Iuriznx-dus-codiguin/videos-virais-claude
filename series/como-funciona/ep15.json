 "falas": [
  {
   "id": "f1",
   "quem": "tito",
   "texto": "Se você enrolar fio de cobre num prego e ligar na pilha, ele vira um ÍMÃ.",
   "tom": "animado"
  },
  {
   "id": "f2",
   "quem": "tito",
   "texto": "MAS ímã só puxa e empurra. Como fazer ele GIRAR sem parar?",
   "tom": "tenso",
   "pausa_depois": 0.3
  },
  {
   "id": "f3",
   "quem": "tito",
   "texto": "Então, você espeta o prego num EIXO, entre dois ímãs de verdade."
  },
  {
   "id": "f4",
   "quem": "tito",
   "texto": "Os opostos se puxam, e o prego VIRA!",
   "tom": "animado",
   "pausa_depois": 0.3
  },
  {
   "id": "f5",
   "quem": "tito",
   "texto": "SÓ QUE ele para de cara com o ímã, e fica TRAVADO ali.",
   "tom": "tenso",
   "pausa_depois": 0.3
  },
  {
   "id": "f6",
   "quem": "tito",
   "texto": "Então, você põe no eixo um anel cortado ao meio, o COMUTADOR.",
   "semente": 103
  },
  {
   "id": "f7",
   "quem": "tito",
   "texto": "A cada meia volta, ele troca a corrente de lado, e o prego troca de POLO."
  },
  {
   "id": "f8",
   "quem": "tito",
   "texto": "Agora o ímã que puxava EMPURRA, e o eixo gira sem parar!",
   "tom": "animado",
   "pausa_depois": 0.3
  },
  {
   "id": "f9",
   "quem": "tito",
   "texto": "MAS, com o eixo girando, os fios da pilha vão se ENROLAR todos.",
   "tom": "tenso",
   "pausa_depois": 0.3
  },
  {
   "id": "f10",
   "quem": "tito",
   "texto": "Então, você usa ESCOVAS: dois carvõezinhos que só encostam no anel e passam a corrente."
  },
  {
   "id": "f11",
   "quem": "tito",
   "texto": "SÓ QUE a corrente esquenta o fio de cobre, e se o calor não sai, o motor QUEIMA.",
   "tom": "tenso",
   "pausa_depois": 0.35
  },
  {
   "id": "f12",
   "quem": "tito",
   "texto": "Então, você prende uma VENTOINHA no próprio eixo: o motor gira e se refresca sozinho.",
   "pausa_depois": 0.3
  },
  {
   "id": "f13",
   "quem": "tito",
   "texto": "MAS ainda existe outro problema: se o prego para no ponto errado, o motor nem PEGA.",
   "tom": "tenso",
   "pausa_depois": 0.3
  },
  {
   "id": "f14",
   "quem": "tito",
   "texto": "Então, você coloca mais BOBINAS, mais pregos enrolados, cada um empurrando na sua vez.",
   "pausa_depois": 0.3
  },
  {
   "id": "f15",
   "quem": "tito",
   "texto": "E o mais doido: gire esse eixo com a mão, e ele vira um GERADOR de eletricidade.",
   "tom": "animado",
   "pausa_depois": 0.3
  },
  {
   "id": "f16",
   "quem": "tito",
   "texto": "Ímã e fio de cobre giram quase tudo na sua casa: ventilador, liquidificador, lavadora.",
   "pausa_depois": 0.3
  },
  {
   "id": "f17",
   "quem": "tito",
   "texto": "Parabéns! Você construiu um MOTOR elétrico!",
   "tom": "animado"
  }
 ],
