{
  "serie": "o-mapa",
  "parte": 3,
  "titulo": "A árvore que chora",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "nico",
      "off": true,
      "texto": "Se você achar um esconderijo secreto numa ilha deserta, não durma lá DENTRO.",
      "tom": "tenso"
    },
    {
      "id": "f2",
      "quem": "nico",
      "off": true,
      "texto": "Porque quem cavou esse buraco deixou recado na parede."
    },
    {
      "id": "f3",
      "quem": "nico",
      "off": true,
      "texto": "Mas só se você ler a parede INTEIRA.",
      "tom": "serio"
    },
    {
      "id": "f4",
      "quem": "nico",
      "off": true,
      "texto": "Eu e minha irmã Duda caçamos quarenta barras de ouro de 1962."
    },
    {
      "id": "f5",
      "quem": "nico",
      "off": true,
      "texto": "E a Marina Caveira acaba de pegar a gente escondido.",
      "tom": "tenso"
    },
    {
      "id": "f6",
      "quem": "marina",
      "texto": "Vocês não sabem com quem vieram.",
      "tom": "serio"
    },
    {
      "id": "f7",
      "quem": "nico",
      "off": true,
      "texto": "Aí chega o Seu Jonas com a lanterna. Ela corre."
    },
    {
      "id": "f8",
      "quem": "marina",
      "texto": "Pergunta pra ele o nome do BARCO!",
      "tom": "grito"
    },
    {
      "id": "f9",
      "quem": "nico",
      "off": true,
      "texto": "Meu primeiro instinto é perguntar na hora."
    },
    {
      "id": "f10",
      "quem": "nico",
      "off": true,
      "texto": "Não. Sozinhos com ele, de noite, numa ilha? A gente sorri.",
      "tom": "serio"
    },
    {
      "id": "f11",
      "quem": "nico",
      "off": true,
      "texto": "Onze da noite. Dezenove horas pra tempestade.",
      "tom": "tenso"
    },
    {
      "id": "f12",
      "quem": "nico",
      "off": true,
      "texto": "Agora tem lanterna. Faltam noventa passos."
    },
    {
      "id": "f13",
      "quem": "nico",
      "off": true,
      "texto": "Trezentos. Uma figueira gigante pingando água das raízes."
    },
    {
      "id": "f14",
      "quem": "duda",
      "texto": "A árvore que CHORA."
    },
    {
      "id": "f15",
      "quem": "nico",
      "off": true,
      "texto": "Embaixo das raízes, um buraco do tamanho de um quarto."
    },
    {
      "id": "f16",
      "quem": "nico",
      "off": true,
      "texto": "Na parede, duzentos e catorze riscos. Um por dia."
    },
    {
      "id": "f17",
      "quem": "nico",
      "texto": "Nem de castigo eu fiquei tanto tempo."
    },
    {
      "id": "f18",
      "quem": "duda",
      "texto": "Foi o FAROLEIRO. Ele morou aqui."
    },
    {
      "id": "f19",
      "quem": "duda",
      "texto": "Onde a luz gira, espere o primeiro SOL."
    },
    {
      "id": "f20",
      "quem": "jonas",
      "texto": "Que menina esperta! Amanhã cedo a gente resolve.",
      "tom": "animado"
    },
    {
      "id": "f21",
      "quem": "nico",
      "off": true,
      "texto": "Então a gente forra o chão, apaga a luz e deita."
    },
    {
      "id": "f22",
      "quem": "nico",
      "off": true,
      "texto": "Pela primeira vez, a ilha parece segura.",
      "tom": "aliviado"
    },
    {
      "id": "f23",
      "quem": "nico",
      "off": true,
      "texto": "Só que a lanterna da Duda acha riscos mais novos.",
      "tom": "tenso"
    },
    {
      "id": "f24",
      "quem": "nico",
      "off": true,
      "texto": "O Seu Jonas já morou AQUI.",
      "tom": "tenso"
    }
  ],
