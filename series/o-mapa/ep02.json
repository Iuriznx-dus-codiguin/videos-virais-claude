{
  "serie": "o-mapa",
  "parte": 2,
  "titulo": "A ilha",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "nico",
      "off": true,
      "texto": "Se você achar uma fogueira ainda quente numa ilha DESERTA, não grite: tem alguém aí?",
      "tom": "tenso"
    },
    {
      "id": "f2",
      "quem": "nico",
      "off": true,
      "texto": "Porque quem acendeu ainda não sabe que você chegou."
    },
    {
      "id": "f3",
      "quem": "nico",
      "off": true,
      "texto": "Mas só se você souber ONDE essa pessoa está.",
      "tom": "serio"
    },
    {
      "id": "f4",
      "quem": "nico",
      "off": true,
      "texto": "Minha irmã Duda e eu seguimos o mapa do tesouro de um faroleiro."
    },
    {
      "id": "f5",
      "quem": "nico",
      "off": true,
      "texto": "E o Seu Jonas, que trouxe a gente, já sabia do mapa."
    },
    {
      "id": "f6",
      "quem": "jonas",
      "texto": "Todo pescador daqui conhece a lenda do faroleiro, menino!",
      "tom": "animado"
    },
    {
      "id": "f7",
      "quem": "duda",
      "texto": "Ele riu rápido DEMAIS, Nico.",
      "tom": "serio"
    },
    {
      "id": "f8",
      "quem": "nico",
      "off": true,
      "texto": "Sete e vinte, a ilha. A tempestade chega amanhã às seis.",
      "tom": "tenso"
    },
    {
      "id": "f9",
      "quem": "duda",
      "texto": "Do farol, trezentos passos até a árvore que CHORA."
    },
    {
      "id": "f10",
      "quem": "nico",
      "off": true,
      "texto": "Só que o mapa não diz pra que LADO."
    },
    {
      "id": "f11",
      "quem": "nico",
      "off": true,
      "texto": "A gente conta pela trilha."
    },
    {
      "id": "f12",
      "quem": "nico",
      "off": true,
      "texto": "Duzentos e dez passos... e uma fogueira ainda QUENTE.",
      "tom": "tenso"
    },
    {
      "id": "f13",
      "quem": "nico",
      "off": true,
      "texto": "Meu primeiro instinto é gritar se tem alguém aí."
    },
    {
      "id": "f14",
      "quem": "nico",
      "off": true,
      "texto": "Não. Quem se esconde numa ilha deserta não quer visita.",
      "tom": "serio"
    },
    {
      "id": "f15",
      "quem": "nico",
      "off": true,
      "texto": "No escuro ninguém conta passo. Então o Seu Jonas acende um fogo."
    },
    {
      "id": "f16",
      "quem": "nico",
      "off": true,
      "texto": "Dez e quarenta, uma lanterna anda entre as árvores.",
      "tom": "tenso"
    },
    {
      "id": "f17",
      "quem": "jonas",
      "texto": "É a Marina CAVEIRA. Ela não divide nada.",
      "tom": "serio"
    },
    {
      "id": "f18",
      "quem": "nico",
      "off": true,
      "texto": "Ele apaga o fogo e some atrás dela."
    },
    {
      "id": "f19",
      "quem": "nico",
      "off": true,
      "texto": "A gente se esconde atrás do tronco, sem respirar."
    },
    {
      "id": "f20",
      "quem": "nico",
      "off": true,
      "texto": "A lanterna passa... e vai embora. Nunca fiquei tão quieto na vida.",
      "tom": "aliviado"
    },
    {
      "id": "f21",
      "quem": "nico",
      "off": true,
      "texto": "Só que ninguém olhou pra TRÁS.",
      "tom": "tenso"
    },
    {
      "id": "f22",
      "quem": "marina",
      "texto": "Então vocês acharam a OUTRA garrafa.",
      "tom": "serio"
    }
  ],
