{
  "serie": "o-mapa",
  "parte": 4,
  "titulo": "O farol",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "nico",
      "off": true,
      "texto": "Se quem te trouxe pra ilha mentiu pra você, não fuja. Suba no FAROL.",
      "tom": "tenso"
    },
    {
      "id": "f2",
      "quem": "nico",
      "off": true,
      "texto": "Porque o enigma do mapa aponta pra lá."
    },
    {
      "id": "f3",
      "quem": "nico",
      "off": true,
      "texto": "Mas só se você chegar antes do primeiro SOL.",
      "tom": "serio"
    },
    {
      "id": "f4",
      "quem": "nico",
      "off": true,
      "texto": "Eu e minha irmã Duda caçamos ouro de um mapa de 1962."
    },
    {
      "id": "f5",
      "quem": "nico",
      "off": true,
      "texto": "E o Seu Jonas nunca contou que já morou aqui.",
      "tom": "tenso"
    },
    {
      "id": "f6",
      "quem": "nico",
      "off": true,
      "texto": "Então a gente finge que dorme. Às quatro, sai de fininho."
    },
    {
      "id": "f7",
      "quem": "nico",
      "off": true,
      "texto": "Meu primeiro instinto é pegar o barco dele e fugir."
    },
    {
      "id": "f8",
      "quem": "nico",
      "off": true,
      "texto": "Não. Eu tenho quinze anos. Só sei pilotar bicicleta.",
      "tom": "serio"
    },
    {
      "id": "f9",
      "quem": "nico",
      "off": true,
      "texto": "Quatro e dez. O sol nasce às cinco e doze.",
      "tom": "tenso"
    },
    {
      "id": "f10",
      "quem": "duda",
      "texto": "Luz que gira só tem uma. O FAROL."
    },
    {
      "id": "f11",
      "quem": "nico",
      "off": true,
      "texto": "Cento e vinte degraus no escuro."
    },
    {
      "id": "f12",
      "quem": "nico",
      "off": true,
      "texto": "Só que lá em cima tem uma luz ACESA.",
      "tom": "tenso"
    },
    {
      "id": "f13",
      "quem": "marina",
      "texto": "Demoraram. A menina lê enigma muito ALTO.",
      "tom": "serio"
    },
    {
      "id": "f14",
      "quem": "nico",
      "off": true,
      "texto": "A Marina Caveira. Sozinha com a gente, no alto do farol.",
      "tom": "tenso"
    },
    {
      "id": "f15",
      "quem": "marina",
      "texto": "Todo mundo diz que o faroleiro roubou o ouro."
    },
    {
      "id": "f16",
      "quem": "marina",
      "texto": "Ele era meu AVÔ. E não roubou nada.",
      "tom": "serio"
    },
    {
      "id": "f17",
      "quem": "nico",
      "off": true,
      "texto": "Em 1962, o Aurélio salvou o ouro de um barco de ladrões."
    },
    {
      "id": "f18",
      "quem": "nico",
      "off": true,
      "texto": "Às cinco e doze, o primeiro sol bate na lente."
    },
    {
      "id": "f19",
      "quem": "nico",
      "off": true,
      "texto": "E o reflexo cai bem na figueira."
    },
    {
      "id": "f20",
      "quem": "duda",
      "texto": "O ouro tá embaixo de onde a gente DORMIU."
    },
    {
      "id": "f21",
      "quem": "nico",
      "off": true,
      "texto": "Então a gente marca a árvore no mapa e respira."
    },
    {
      "id": "f22",
      "quem": "nico",
      "off": true,
      "texto": "Pela primeira vez, a gente tá um passo na frente.",
      "tom": "aliviado"
    },
    {
      "id": "f23",
      "quem": "duda",
      "texto": "E o barco dos ladrões? Qual era?"
    },
    {
      "id": "f24",
      "quem": "marina",
      "texto": "Chamava TUBARÃO.",
      "tom": "serio"
    },
    {
      "id": "f25",
      "quem": "nico",
      "off": true,
      "texto": "O do Seu Jonas é o Tubarão DOIS.",
      "tom": "tenso"
    }
  ],
