{
  "serie": "o-mapa",
  "parte": 5,
  "titulo": "O mapa falso",
  "musica": "misterio",
  "falas": [
    {
      "id": "f1",
      "quem": "nico",
      "off": true,
      "texto": "Se você souber onde está o tesouro, não cave com o dono do barco olhando.",
      "tom": "tenso"
    },
    {
      "id": "f2",
      "quem": "nico",
      "off": true,
      "texto": "Porque ele nunca viu o mapa de verdade."
    },
    {
      "id": "f3",
      "quem": "nico",
      "off": true,
      "texto": "Mas só se ele cair no mapa FALSO.",
      "tom": "serio"
    },
    {
      "id": "f4",
      "quem": "nico",
      "off": true,
      "texto": "Eu e minha irmã Duda caçamos o ouro de um mapa de 1962."
    },
    {
      "id": "f5",
      "quem": "nico",
      "off": true,
      "texto": "E o barco do Seu Jonas tem o nome do barco dos ladrões.",
      "tom": "tenso"
    },
    {
      "id": "f6",
      "quem": "nico",
      "off": true,
      "texto": "Meu primeiro instinto é fugir no barco da Marina."
    },
    {
      "id": "f7",
      "quem": "nico",
      "off": true,
      "texto": "Não. O barco dela só volta amanhã.",
      "tom": "serio"
    },
    {
      "id": "f8",
      "quem": "nico",
      "off": true,
      "texto": "Sete da manhã. Onze horas pra tempestade.",
      "tom": "tenso"
    },
    {
      "id": "f9",
      "quem": "nico",
      "off": true,
      "texto": "Então a Duda faz um mapa falso, com o X na praia.",
      "semente": 305
    },
    {
      "id": "f10",
      "quem": "nico",
      "off": true,
      "texto": "E esquece o mapa do lado do Seu Jonas. De propósito."
    },
    {
      "id": "f11",
      "quem": "jonas",
      "texto": "Vou pescar ali na praia, criançada!",
      "tom": "animado"
    },
    {
      "id": "f12",
      "quem": "nico",
      "texto": "Pescar? Sem vara, sem isca e sem BARCO."
    },
    {
      "id": "f13",
      "quem": "nico",
      "off": true,
      "texto": "A gente cava nas raízes. Trinta, sessenta, cem centímetros."
    },
    {
      "id": "f14",
      "quem": "nico",
      "off": true,
      "texto": "E a gente bate em MADEIRA.",
      "tom": "tenso"
    },
    {
      "id": "f15",
      "quem": "duda",
      "texto": "Quarenta barras. Todas AQUI!",
      "tom": "animado"
    },
    {
      "id": "f16",
      "quem": "nico",
      "off": true,
      "texto": "Doze quilos cada. Quase meia tonelada."
    },
    {
      "id": "f17",
      "quem": "nico",
      "off": true,
      "texto": "O Seu Jonas dormiu meses em cima disso. E nunca soube."
    },
    {
      "id": "f18",
      "quem": "marina",
      "texto": "Vovô tinha razão.",
      "tom": "triste"
    },
    {
      "id": "f19",
      "quem": "nico",
      "off": true,
      "texto": "A Marina chora. Uma mentira de 1962 acaba ali."
    },
    {
      "id": "f20",
      "quem": "nico",
      "off": true,
      "texto": "Então a gente fecha o caixote e cobre com folhas."
    },
    {
      "id": "f21",
      "quem": "nico",
      "off": true,
      "texto": "Pela primeira vez, o plano da Duda funcionou.",
      "tom": "aliviado"
    },
    {
      "id": "f22",
      "quem": "nico",
      "off": true,
      "texto": "Só que o Seu Jonas não foi pra praia.",
      "tom": "tenso"
    },
    {
      "id": "f23",
      "quem": "jonas",
      "texto": "Belo mapa, menina. Mas eu sei contar PASSOS.",
      "tom": "serio"
    },
    {
      "id": "f24",
      "quem": "jonas",
      "texto": "Ouro no meu barco. Até as CINCO.",
      "tom": "serio"
    }
  ],
