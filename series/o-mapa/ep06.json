{
  "serie": "o-mapa",
  "parte": 6,
  "titulo": "A troca",
  "musica": "tensao",
  "falas": [
    {
      "id": "f1",
      "quem": "nico",
      "off": true,
      "texto": "Se um ladrão mandar você encher o barco dele de ouro, não tenha PRESSA.",
      "tom": "tenso"
    },
    {
      "id": "f2",
      "quem": "nico",
      "off": true,
      "texto": "Porque o mar pode fazer o serviço por você."
    },
    {
      "id": "f3",
      "quem": "nico",
      "off": true,
      "texto": "Mas só se você acertar a hora no MINUTO.",
      "tom": "serio"
    },
    {
      "id": "f4",
      "quem": "nico",
      "off": true,
      "texto": "Eu e minha irmã Duda achamos quarenta barras de ouro de 1962."
    },
    {
      "id": "f5",
      "quem": "nico",
      "off": true,
      "texto": "E o Seu Jonas quer tudo no barco dele até as cinco.",
      "tom": "tenso"
    },
    {
      "id": "f6",
      "quem": "nico",
      "off": true,
      "texto": "Meu primeiro instinto é esconder o ouro e esperar a tempestade."
    },
    {
      "id": "f7",
      "quem": "nico",
      "off": true,
      "texto": "Não. Aí ele passa a tempestade aqui. Com a gente.",
      "tom": "serio"
    },
    {
      "id": "f8",
      "quem": "nico",
      "off": true,
      "texto": "Quatro da tarde. Duas horas pra tempestade.",
      "tom": "tenso"
    },
    {
      "id": "f9",
      "quem": "duda",
      "texto": "A maré baixa às cinco e quarenta. Olha o RECIFE."
    },
    {
      "id": "f10",
      "quem": "nico",
      "off": true,
      "texto": "Na maré baixa, um recife aparece bem na frente do cais."
    },
    {
      "id": "f11",
      "quem": "nico",
      "off": true,
      "texto": "Com meia tonelada de ouro, o barco dele encalha."
    },
    {
      "id": "f12",
      "quem": "marina",
      "texto": "Marinha, aqui é a Marina. Ilha das Gaivotas. Câmbio."
    },
    {
      "id": "f13",
      "quem": "nico",
      "off": true,
      "texto": "Então a gente enrola. Uma barra de cada vez."
    },
    {
      "id": "f14",
      "quem": "nico",
      "off": true,
      "texto": "A Marina conta as barras. E erra de propósito."
    },
    {
      "id": "f15",
      "quem": "marina",
      "texto": "Trinta e um... trinta e dois... perdi a CONTA."
    },
    {
      "id": "f16",
      "quem": "jonas",
      "texto": "Conta de novo, Caveira! E rápido!",
      "tom": "bravo"
    },
    {
      "id": "f17",
      "quem": "nico",
      "texto": "E eu achando que era ruim de matemática."
    },
    {
      "id": "f18",
      "quem": "nico",
      "off": true,
      "texto": "Cinco e trinta e oito. O barco sai carregado.",
      "tom": "tenso"
    },
    {
      "id": "f19",
      "quem": "nico",
      "off": true,
      "texto": "Direto pro recife."
    },
    {
      "id": "f20",
      "quem": "duda",
      "texto": "Mais dois MINUTOS."
    },
    {
      "id": "f21",
      "quem": "nico",
      "off": true,
      "texto": "Pela primeira vez, o mar tá do nosso lado.",
      "tom": "aliviado"
    },
    {
      "id": "f22",
      "quem": "nico",
      "off": true,
      "texto": "Só que, no último segundo, o barco vira.",
      "tom": "tenso"
    },
    {
      "id": "f23",
      "quem": "jonas",
      "texto": "Eu nasci nesse mar, MENINA!",
      "tom": "grito"
    }
  ],
