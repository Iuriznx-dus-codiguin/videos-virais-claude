{
  "serie": "o-mapa",
  "parte": 7,
  "titulo": "O farol aceso",
  "musica": "tensao",
  "falas": [
    {
      "id": "f1",
      "quem": "nico",
      "off": true,
      "texto": "Se um ladrão fugir com o seu ouro numa tempestade, não corra atrás dele.",
      "tom": "tenso"
    },
    {
      "id": "f2",
      "quem": "nico",
      "off": true,
      "texto": "Porque, no escuro, quem acende uma luz manda no mar."
    },
    {
      "id": "f3",
      "quem": "nico",
      "off": true,
      "texto": "Mas só se essa luz não estiver apagada desde 1962.",
      "tom": "serio"
    },
    {
      "id": "f4",
      "quem": "nico",
      "off": true,
      "texto": "Eu e a Duda achamos quarenta barras de ouro nessa ilha."
    },
    {
      "id": "f5",
      "quem": "nico",
      "off": true,
      "texto": "E o Seu Jonas acabou de fugir com TUDO.",
      "tom": "tenso"
    },
    {
      "id": "f6",
      "quem": "marina",
      "texto": "A Marinha chega em vinte minutos."
    },
    {
      "id": "f7",
      "quem": "nico",
      "off": true,
      "texto": "Pronto. É só esperar a lancha.",
      "tom": "aliviado"
    },
    {
      "id": "f8",
      "quem": "nico",
      "off": true,
      "texto": "Não. Na chuva, ninguém acha um barco de luz apagada.",
      "tom": "serio"
    },
    {
      "id": "f9",
      "quem": "nico",
      "off": true,
      "texto": "Seis da tarde. Em vinte minutos ele some atrás da ilha.",
      "tom": "tenso"
    },
    {
      "id": "f10",
      "quem": "marina",
      "texto": "Então a gente acende o farol do meu AVÔ."
    },
    {
      "id": "f11",
      "quem": "nico",
      "off": true,
      "texto": "Só que lá em cima, nenhuma lâmpada funciona."
    },
    {
      "id": "f12",
      "quem": "duda",
      "texto": "A lente aumenta qualquer luz. Até uma LANTERNA."
    },
    {
      "id": "f13",
      "quem": "nico",
      "off": true,
      "texto": "E o farol do seu Aurélio acende. Pela primeira vez desde 1962.",
      "semente": 103
    },
    {
      "id": "f14",
      "quem": "nico",
      "off": true,
      "texto": "A Marina gira a lente na mão, e a luz varre o mar."
    },
    {
      "id": "f15",
      "quem": "duda",
      "texto": "Ali! De luz APAGADA!"
    },
    {
      "id": "f16",
      "quem": "jonas",
      "texto": "Apaga essa LUZ!",
      "tom": "grito"
    },
    {
      "id": "f17",
      "quem": "nico",
      "off": true,
      "texto": "Cego pela luz, ele vira o barco direto no banco de areia.",
      "tom": "tenso"
    },
    {
      "id": "f18",
      "quem": "nico",
      "off": true,
      "texto": "E com meia tonelada de ouro, o Tubarão Dois encalha."
    },
    {
      "id": "f19",
      "quem": "nico",
      "texto": "O plano da maré funcionou. Com quarenta minutos de atraso."
    },
    {
      "id": "f20",
      "quem": "nico",
      "off": true,
      "texto": "A Marinha chega. O Seu Jonas sai preso, e o ouro vai pro museu.",
      "tom": "aliviado"
    },
    {
      "id": "f21",
      "quem": "nico",
      "off": true,
      "texto": "E o jornal finalmente limpa o nome do seu Aurélio.",
      "semente": 103
    },
    {
      "id": "f22",
      "quem": "nico",
      "off": true,
      "texto": "Segunda, eu devolvo a garrafa pro mar. Com um obrigado."
    },
    {
      "id": "f23",
      "quem": "nico",
      "off": true,
      "texto": "E o farol dele nunca mais apagou."
    }
  ],
